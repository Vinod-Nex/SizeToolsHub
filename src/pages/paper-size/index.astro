---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperConverterIsland from '../../components/PaperConverterIsland';
import PaperComparisonVisual from '../../components/PaperComparisonVisual.astro';
import PaperStaticTable from '../../components/PaperStaticTable.astro';

// Query all paper size converters
const entries = await getCollection('converters', ({ data }) => data.converterType === 'paper-size');

const tools = entries.map((entry) => ({
  slug: entry.id.replace(/^paper-size\//, '').replace(/\.(json|md)$/, ''),
  title: entry.data.title,
  primaryKeyword: entry.data.primaryKeyword,
  description: entry.data.metaDescription,
  fromUnit: entry.data.fromUnit,
  toUnit: entry.data.toUnit,
}));

const hubFaq = [
  {
    question: "What is the primary difference between A4 and US Letter?",
    answer: "A4 paper (210 × 297 mm / 8.27 × 11.69 in) is part of the international ISO 216 standard used across Europe, Asia, Australia, and Latin America. US Letter (215.9 × 279.4 mm / 8.5 × 11.0 in) is used primarily in the United States and Canada. A4 is 17.6 mm (0.69 in) taller, while US Letter is 5.9 mm (0.23 in) wider."
  },
  {
    question: "Why do ISO paper sizes maintain the √2 aspect ratio?",
    answer: "The German physicist Georg Christoph Lichtenberg recognized that an aspect ratio of 1:√2 (approximately 1:1.4142) has the unique geometric property that halving the sheet along its long edge produces two smaller sheets with the exact same aspect ratio. This allows seamless booklet printing, photocopying, and scaling (e.g., A3 to A4) without distortion or margin shifts."
  },
  {
    question: "What size envelope fits an unfolded A4 document?",
    answer: "A C4 envelope (229 × 324 mm / 9.02 × 12.76 in) is specifically designed to hold flat, unfolded A4 sheets. If folding an A4 sheet in half, use a C5 envelope (162 × 229 mm). If tri-folding A4 lengthwise into three sections, use a standard DL envelope (110 × 220 mm)."
  },
  {
    question: "What resolution (pixels) is required to print A4 or Letter at 300 DPI?",
    answer: "For sharp, professional photographic prints at 300 DPI (dots per inch), an A4 sheet requires 2480 × 3508 pixels (~8.7 megapixels). A US Letter sheet requires 2550 × 3300 pixels (~8.4 megapixels)."
  }
];
---

<BaseLayout
  title="Paper Size Converters & Document Dimensions Chart — SizeToolsHub"
  description="Compare global paper dimensions between ISO 216 (A4, A3, A5), North American standards (US Letter, Legal, Tabloid), commercial envelopes, and poster prints in mm, cm, inches, and pixels."
  faq={hubFaq}
>
  <!-- Breadcrumbs -->
  <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-text-muted pt-6 pb-2" aria-label="Breadcrumb">
    <a href="/" class="hover:text-ink transition-colors">Home</a>
    <span>/</span>
    <span class="text-ink font-semibold">Paper Size</span>
  </nav>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- Category Header -->
    <header class="mb-10 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-ink border border-hairline-soft">
          Category Hub
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          {entries.length} Specialized Converters
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink mb-4" style="line-height: 1.1;">
        Paper Size Converters & Print Dimension Guides.
      </h1>

      <p class="text-base sm:text-lg text-text-muted font-light leading-relaxed">
        Accurately compare international ISO 216 standards (A0 through A8, B-series), North American office sizes (Letter, Legal, Tabloid), commercial mailing envelopes (C4, C5, DL, #10), and large-format poster prints in millimeters, inches, and 300 DPI pixels.
      </p>
    </header>

    <!-- Quick Live Interactive Converter Island -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs uppercase tracking-wider text-text-faint font-semibold">
          Universal Paper Sizing Engine
        </h2>
        <span class="text-xs text-text-muted">Interactive Calculator</span>
      </div>
      <PaperConverterIsland
        client:visible
        initialFromUnit="A4"
        initialToUnit="US Letter"
        primaryKeyword="Universal Paper Dimensions Converter"
      />
    </section>

    <!-- Visual Size Comparison SVG Component Showcase -->
    <PaperComparisonVisual
      fromUnit="A4"
      toUnit="US Letter"
      caption="Interactive Vector Scale: A4 (210 × 297 mm) vs US Letter (215.9 × 279.4 mm) true geometric proportions."
    />

    <!-- Sub-Tool Directory Grid -->
    <section class="mb-16" aria-labelledby="tools-directory-heading">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
            <span>Dedicated Tools</span>
          </div>
          <h2 id="tools-directory-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
            Paper & Print Converters Directory.
          </h2>
          <p class="text-sm sm:text-base text-text-muted font-light mt-1">
            Dedicated cross-standard converters, envelope fold guides, and poster dimension charts.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {tools.map((tool) => (
          <a
            href={`/paper-size/${tool.slug}/`}
            class="group p-6 rounded-3xl bg-canvas border border-hairline-soft hover:border-hairline hover:-translate-y-1 transition-all duration-200 shadow-2xs hover:shadow-xs flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-semibold text-accent px-2.5 py-0.5 rounded-full bg-accent/10">
                  {tool.fromUnit} ⇄ {tool.toUnit}
                </span>
                <span class="text-xs text-text-faint group-hover:text-ink transition-colors">→</span>
              </div>
              <h3 class="text-lg font-bold text-ink mb-2 group-hover:text-accent transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs sm:text-sm text-text-muted font-light leading-relaxed">
                {tool.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-hairline-soft flex items-center justify-between text-xs text-text-muted">
              <span>View Specs & SVG</span>
              <span class="font-medium text-ink group-hover:translate-x-0.5 transition-transform">Explore →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Educational Guide: ISO 216 vs ANSI -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16" aria-label="Paper Standards Guide">
      <div class="p-6 rounded-3xl bg-canvas border border-hairline-soft">
        <div class="w-10 h-10 rounded-2xl bg-accent/10 flex items-center justify-center text-accent mb-4 font-bold text-lg">
          √2
        </div>
        <h3 class="text-base font-bold text-ink mb-2">The ISO 216 System</h3>
        <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
          Standardized in 1975, the ISO system is used in over 140 countries. Starting with A0 (exactly 1 square meter in area), each subsequent size (A1, A2, A3, A4) is formed by halving the preceding sheet while keeping the aspect ratio identical.
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-canvas border border-hairline-soft">
        <div class="w-10 h-10 rounded-2xl bg-purple-500/10 flex items-center justify-center text-purple-600 dark:text-purple-400 mb-4 font-bold text-lg">
          8.5″
        </div>
        <h3 class="text-base font-bold text-ink mb-2">The North American Standard</h3>
        <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
          Rooted in historic papermaking traditions, US Letter (8.5 × 11 in) and Legal (8.5 × 14 in) govern offices in the US, Canada, and parts of Mexico. Unlike ISO sheets, their aspect ratios do not scale geometrically when cut or folded.
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-canvas border border-hairline-soft">
        <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 flex items-center justify-center text-emerald-600 dark:text-emerald-400 mb-4 font-bold text-lg">
          300
        </div>
        <h3 class="text-base font-bold text-ink mb-2">Commercial Print Resolution</h3>
        <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
          Offset presses and digital laser printers require at least 300 DPI (dots per inch) for clean typography and razor-sharp photographic reproduction. Use our pixel calculators to prepare bleed and trim margins accurately.
        </p>
      </div>
    </section>

    <!-- Static Reference Tables -->
    <PaperStaticTable />

    <!-- FAQ Accordion -->
    <section class="mt-16 pt-12 border-t border-hairline-soft" aria-labelledby="hub-faq-heading">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
          <span>Frequently Asked Questions</span>
        </div>
        <h2 id="hub-faq-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Expert Answers on Global Paper Formats.
        </h2>
        <p class="text-sm sm:text-base text-text-muted font-light mt-1">
          Everything you need to know about international document standards, margin cropping, and envelope compatibility.
        </p>
      </div>

      <div class="space-y-3">
        {hubFaq.map((item) => (
          <details class="group rounded-2xl bg-canvas border border-hairline-soft p-5 transition-colors cursor-pointer open:bg-canvas-soft/60">
            <summary class="flex items-center justify-between text-base font-semibold text-ink list-none select-none">
              <span>{item.question}</span>
              <span class="text-text-muted group-open:rotate-180 transition-transform duration-200">
                ↓
              </span>
            </summary>
            <p class="mt-4 text-sm text-text-muted leading-relaxed font-normal">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
