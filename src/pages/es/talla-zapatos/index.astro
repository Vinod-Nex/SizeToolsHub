---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShoeConverterIsland from '../../../components/ShoeConverterIsland';
import ShoeStaticTableEs from '../../../components/ShoeStaticTableEs.astro';

// Query all Spanish shoe converters
const entries = await getCollection('converters', ({ id, data }) =>
  id.startsWith('es/talla-zapatos/') || data.converterType === 'talla-zapatos'
);

const tools = entries.map((entry) => ({
  slug: entry.id.replace(/^es\/talla-zapatos\//, '').replace(/\.(json|md)$/, ''),
  title: entry.data.title,
  primaryKeyword: entry.data.primaryKeyword,
  description: entry.data.metaDescription,
  fromUnit: entry.data.fromUnit,
  toUnit: entry.data.toUnit,
}));

const hubFaq = [
  {
    question: "¿Cómo convertir la talla de calzado de Estados Unidos a Europa y España?",
    answer: "Para calzado masculino, suma aproximadamente 33 a la talla de EE. UU. (un US 9 hombre equivale a un 42 en España/EU; US 10 equivale a un 43). Para calzado femenino, añade 30.5 o 31 (un US 7 mujer equivale a un 37.5-38). En México (MX), la numeración se expresa directamente en centímetros."
  },
  {
    question: "¿La talla española de zapatos es diferente a la europea?",
    answer: "No, España utiliza el estándar continental europeo unificado (EU) basado en el punto de París (6.67 mm). Es idéntica a la utilizada en Francia, Alemania e Italia."
  },
  {
    question: "¿Cómo medirse el pie en centímetros para no equivocarse al comprar online?",
    answer: "Pisa descalzo sobre una hoja de papel pegada a la pared. Marca la punta del dedo más largo con un lápiz y mide la distancia hasta el talón con una regla. Añade entre 0.8 cm y 1.2 cm de holgura y consulta la medida 'CM' o 'JP' en la etiqueta de la marca."
  },
  {
    question: "¿Las marcas deportivas (Nike, Adidas, Converse) tienen hormas diferentes?",
    answer: "Sí. Nike suele tener un empeine más ajustado, mientras que Adidas usa tallas fraccionarias en tercios (como 42 2/3). Las zapatillas Converse Chuck Taylor All Star son reconocidas por tallar grandes, por lo que se recomienda comprar media talla menos de la habitual."
  }
];
---

<BaseLayout
  title="Tabla de Tallas de Zapatos y Calzado: España, México, EE. UU. y Europa — SizeToolsHub"
  description="Convierte tallas de calzado entre España/Europa (EU), Estados Unidos (US), México (MX / cm) y Reino Unido (UK). Calculadora en vivo y tablas oficiales para hombre, mujer y niños."
  lang="es"
  faq={hubFaq}
>
  <!-- Breadcrumbs -->
  <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-text-muted pt-6 pb-2" aria-label="Breadcrumb">
    <a href="/es/" class="hover:text-ink transition-colors">Inicio</a>
    <span>/</span>
    <span class="text-ink font-semibold">Talla de Calzado</span>
  </nav>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- Category Header -->
    <header class="mb-10 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-ink border border-hairline-soft">
          Guía de Calzado Internacional
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          {entries.length} Conversores Especializados
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink mb-4" style="line-height: 1.1;">
        Tabla de Tallas de Calzado: España, México, EE. UU. y Europa.
      </h1>

      <p class="text-base sm:text-lg text-text-muted font-light leading-relaxed">
        Evita devoluciones al comprar zapatos por internet. Convierte medidas de calzado entre España (EU), México (MX), Estados Unidos (US), Reino Unido (UK) y centímetros con calibración ISO 9407 para hombre, mujer y niños.
      </p>
    </header>

    <!-- Quick Live Interactive Converter Island -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs uppercase tracking-wider text-text-faint font-semibold">
          Calculadora de Calzado en Tiempo Real
        </h2>
        <span class="text-xs text-text-muted">Interactivo</span>
      </div>
      <ShoeConverterIsland
        client:load
        initialFromUnit="US Size"
        initialToUnit="EU Size"
        primaryKeyword="Conversor de Talla de Calzado"
      />
    </section>

    <!-- Sub-Tool Directory Grid -->
    <section class="mb-16" aria-labelledby="tools-directory-heading">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
            <span>Herramientas Específicas</span>
          </div>
          <h2 id="tools-directory-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
            Directorio de Conversores de Calzado.
          </h2>
          <p class="text-sm sm:text-base text-text-muted font-light mt-1">
            Selecciona la calculadora exacta según el país o tu marca deportiva favorita.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tools.map((tool) => (
          <a
            href={`/es/talla-zapatos/${tool.slug}/`}
            class="group flex flex-col justify-between p-6 rounded-2xl bg-canvas border border-hairline-soft hover:border-hairline hover:-translate-y-1 transition-all duration-200 shadow-2xs hover:shadow-xs active:scale-[0.99]"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-accent/10 text-accent text-[11px] font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                  <span>{tool.fromUnit} ⇄ {tool.toUnit}</span>
                </span>
                <span class="text-xs text-text-faint group-hover:text-accent group-hover:translate-x-0.5 transition-all">
                  →
                </span>
              </div>
              <h3 class="text-lg font-bold text-ink mb-2 group-hover:text-accent transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs text-text-muted font-light leading-relaxed line-clamp-2">
                {tool.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-hairline-soft flex items-center justify-between text-[11px] text-text-faint">
              <span>{tool.primaryKeyword}</span>
              <span class="font-semibold text-accent group-hover:underline">Calcular ↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Static Reference Table Component (Zero JS, Fast HTML) -->
    <ShoeStaticTableEs />

    <!-- FAQ Section -->
    <section class="mt-16 pt-12 border-t border-hairline-soft">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
          <span>Preguntas Frecuentes</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Dudas Comunes sobre Tallas de Calzado.
        </h2>
        <p class="text-sm sm:text-base text-text-muted font-light mt-1 max-w-2xl">
          Respuestas técnicas para comprar zapatillas y calzado internacional con total confianza.
        </p>
      </div>

      <div class="space-y-4 max-w-3xl">
        {hubFaq.map((item) => (
          <details class="group p-5 rounded-2xl bg-canvas border border-hairline-soft transition-all duration-200 open:border-hairline">
            <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-ink cursor-pointer list-none focus:outline-none">
              <span>{item.question}</span>
              <span class="text-text-muted transition-transform duration-200 group-open:rotate-180">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-text-muted font-light leading-relaxed border-t border-hairline-soft pt-3">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
