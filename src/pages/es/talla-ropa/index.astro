---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ClothingConverterIsland from '../../../components/ClothingConverterIsland';
import ClothingStaticTableEs from '../../../components/ClothingStaticTableEs.astro';

// Query all Spanish clothing converters
const entries = await getCollection('converters', ({ id, data }) =>
  id.startsWith('es/talla-ropa/') || data.converterType === 'talla-ropa'
);

const tools = entries.map((entry) => ({
  slug: entry.id.replace(/^es\/talla-ropa\//, '').replace(/\.(json|md)$/, ''),
  title: entry.data.title,
  primaryKeyword: entry.data.primaryKeyword,
  description: entry.data.metaDescription,
  fromUnit: entry.data.fromUnit,
  toUnit: entry.data.toUnit,
}));

const hubFaq = [
  {
    question: "¿Cómo convertir tallas de ropa de Estados Unidos a España y Europa?",
    answer: "En ropa de mujer, la regla general es sumar 32 a la talla americana: una talla US 4 equivale a una talla 36 en España, US 6 equivale a 38, y US 8 equivale a 40. En trajes de caballero, suma 10 (US 38 = ES 48)."
  },
  {
    question: "¿Qué significan las tallas W y L en pantalones vaqueros?",
    answer: "'W' significa Waist (cintura en pulgadas) y 'L' significa Length (largo de entrepierna en pulgadas). Para obtener tu talla de pantalón en España, suma 10 a la W: una talla W30 equivale a una 40 española."
  },
  {
    question: "¿Cómo se calculan las tallas de sujetador en España?",
    answer: "España utiliza el sistema francés, que añade 15 cm a la medida bajo pecho: un tórax de 75 cm da una talla 90 en España (y 75 en el resto de Europa). La copa (A, B, C, D) se calcula restando el contorno bajo pecho al contorno de busto."
  },
  {
    question: "¿Qué talla mexicana es una talla 38 en España?",
    answer: "Una talla 38 de mujer en España (talla M / US 6) equivale a la talla 32 o Mediana en México. En pantalones de hombre, una 42 española equivale a una 32 mexicana."
  }
];
---

<BaseLayout
  title="Tabla de Tallas de Ropa: España, México, EE. UU. y Europa — SizeToolsHub"
  description="Convierte tallas de ropa femenina y masculina entre España (EU), México (MX), Estados Unidos (US) y Reino Unido (UK). Calculadoras de vestidos, jeans, camisas y sujetadores."
  lang="es"
  faq={hubFaq}
>
  <!-- Breadcrumbs -->
  <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-text-muted pt-6 pb-2" aria-label="Breadcrumb">
    <a href="/es/" class="hover:text-ink transition-colors">Inicio</a>
    <span>/</span>
    <span class="text-ink font-semibold">Talla de Ropa</span>
  </nav>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- Category Header -->
    <header class="mb-10 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-ink border border-hairline-soft">
          Guía de Confección Textil
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          {entries.length} Conversores Especializados
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink mb-4" style="line-height: 1.1;">
        Tabla de Tallas de Ropa: España, México, EE. UU. y Europa.
      </h1>

      <p class="text-base sm:text-lg text-text-muted font-light leading-relaxed">
        Acertar tu talla en marcas extranjeras como Zara, ASOS, Shein o Levi’s ahora es sencillo. Tablas de conversión milimétricas para vestidos, trajes, camisas, pantalones vaqueros y lencería.
      </p>
    </header>

    <!-- Quick Live Interactive Converter Island -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs uppercase tracking-wider text-text-faint font-semibold">
          Calculadora de Ropa en Tiempo Real
        </h2>
        <span class="text-xs text-text-muted">Interactivo</span>
      </div>
      <ClothingConverterIsland
        client:load
        initialFromUnit="US Size"
        initialToUnit="EU Size"
        primaryKeyword="Conversor de Talla de Ropa"
      />
    </section>

    <!-- Sub-Tool Directory Grid -->
    <section class="mb-16" aria-labelledby="clothing-tools-heading">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
            <span>Prendas Específicas</span>
          </div>
          <h2 id="clothing-tools-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
            Directorio de Conversores de Ropa.
          </h2>
          <p class="text-sm sm:text-base text-text-muted font-light mt-1">
            Elige la prenda específica que deseas comprar para obtener la correspondencia exacta.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tools.map((tool) => (
          <a
            href={`/es/talla-ropa/${tool.slug}/`}
            class="group flex flex-col justify-between p-6 rounded-2xl bg-canvas border border-hairline-soft hover:border-hairline hover:-translate-y-1 transition-all duration-200 shadow-2xs hover:shadow-xs active:scale-[0.99]"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-accent/10 text-accent text-[11px] font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                  <span>{tool.fromUnit} ⇄ {tool.toUnit}</span>
                </span>
                <span class="text-xs text-text-faint group-hover:text-accent group-hover:translate-x-0.5 transition-all">
                  →
                </span>
              </div>
              <h3 class="text-lg font-bold text-ink mb-2 group-hover:text-accent transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs text-text-muted font-light leading-relaxed line-clamp-2">
                {tool.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-hairline-soft flex items-center justify-between text-[11px] text-text-faint">
              <span>{tool.primaryKeyword}</span>
              <span class="font-semibold text-accent group-hover:underline">Calcular ↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Static Reference Table Component -->
    <ClothingStaticTableEs />

    <!-- FAQ Section -->
    <section class="mt-16 pt-12 border-t border-hairline-soft">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
          <span>Preguntas Frecuentes</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Dudas Comunes sobre Tallas de Ropa.
        </h2>
        <p class="text-sm sm:text-base text-text-muted font-light mt-1 max-w-2xl">
          Consejos prácticos para tomar tus medidas corporales y elegir prendas en comercios online.
        </p>
      </div>

      <div class="space-y-4 max-w-3xl">
        {hubFaq.map((item) => (
          <details class="group p-5 rounded-2xl bg-canvas border border-hairline-soft transition-all duration-200 open:border-hairline">
            <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-ink cursor-pointer list-none focus:outline-none">
              <span>{item.question}</span>
              <span class="text-text-muted transition-transform duration-200 group-open:rotate-180">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-text-muted font-light leading-relaxed border-t border-hairline-soft pt-3">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
