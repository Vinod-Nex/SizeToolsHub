---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UniversalConverter from '../../components/UniversalConverter';
import { getCollection } from 'astro:content';

const frShoeConverters = await getCollection('converters', ({ id }) =>
  id.startsWith('fr/pointure/')
);
const frClothingConverters = await getCollection('converters', ({ id }) =>
  id.startsWith('fr/taille-vetement/')
);

const categories = [
  {
    name: 'Pointure de Chaussures',
    href: '/fr/pointure/',
    desc: 'Correspondance officielle entre la France (FR/EU), les États-Unis (US), le Royaume-Uni (UK) et les centimètres (CM). Guides Nike, Adidas, Asics et Vans.',
    icon: '👟',
    popularCount: `${frShoeConverters.length} Outils`,
    isLocalized: true,
  },
  {
    name: 'Taille de Vêtements',
    href: '/fr/taille-vetement/',
    desc: 'Tableaux complets de prêt-à-porter, jeans en pouces (W et L), robes, chemises habillées, costumes et soutiens-gorge.',
    icon: '👕',
    popularCount: `${frClothingConverters.length} Outils`,
    isLocalized: true,
  },
  {
    name: 'Taille de Bague',
    href: '/ring-size/',
    desc: 'Diamètre intérieur, circonférence et baguier virtuel à échelle 1:1 pour impression immédiate.',
    icon: '💍',
    popularCount: 'Échelle 1:1',
    isLocalized: false,
  },
  {
    name: 'Cuisine et Mesures',
    href: '/cooking/',
    desc: 'Convertissez tasses américaines (cups), cuillères et onces liquides en grammes (g) et millilitres (ml).',
    icon: '🥣',
    popularCount: 'Grammes Précis',
    isLocalized: false,
  },
  {
    name: 'Stockage de Données',
    href: '/data/',
    desc: 'Calculateur d’octets, Ko, Mo, Go (Gigaoctets) et To (Téraoctets) en base décimale et binaire.',
    icon: '💾',
    popularCount: 'Go ↔ To',
    isLocalized: false,
  },
  {
    name: 'Formats de Papier',
    href: '/paper-size/',
    desc: 'Norme ISO 216 (A4, A3, A5), format Lettre US (Letter) et dimensions pour impression et encadrement.',
    icon: '📄',
    popularCount: 'ISO 216 & Lettre',
    isLocalized: false,
  },
  {
    name: 'Consommation de Carburant',
    href: '/fuel/',
    desc: 'Convertissez les MPG (Miles per Gallon) en L/100km et km/L pour vos véhicules importés.',
    icon: '⛽',
    popularCount: 'MPG ↔ L/100km',
    isLocalized: false,
  },
];

const featuredTools = [
  {
    title: 'Pointure US vers EU / France',
    href: '/fr/pointure/us-vers-eu/',
    badge: 'Le Plus Consulté',
    desc: 'Convertissez instantanément vos pointures de chaussures américaines vers le système français.',
    units: 'US ⇄ France / EU',
  },
  {
    title: 'Tailles Femme : US vers France',
    href: '/fr/taille-vetement/us-vers-eu-femme/',
    badge: 'Mode Féminine',
    desc: 'Guide de conversion pour robes, jupes et manteaux américains (US 0-16) vers la France (FR 32-48).',
    units: 'US Femme ⇄ France (FR)',
  },
  {
    title: 'Tailles de Jeans W et L',
    href: '/fr/taille-vetement/convertisseur-tailles-jeans/',
    badge: 'Jeans Levi\'s',
    desc: 'Comprenez la taille américaine en pouces (W / Waist) et trouvez votre équivalence en taille 38, 40, 42.',
    units: 'Taille W (in) ⇄ Taille France',
  },
  {
    title: 'Guide des Tailles Nike',
    href: '/fr/pointure/guide-tailles-nike/',
    badge: 'Sneakers',
    desc: 'Tableau officiel de conversion des modèles Nike Air Jordan, Dunk et Air Force 1 en centimètres.',
    units: 'Nike France ⇄ Nike US',
  },
  {
    title: 'Guide Tailles Soutien-Gorge',
    href: '/fr/taille-vetement/guide-tailles-soutien-gorge/',
    badge: 'Lingerie',
    desc: 'Calculez votre bonnet exact (A, B, C, D) et votre tour de dos français à partir de vos mensurations en cm.',
    units: 'Mesures (cm) ⇄ Taille FR / EU',
  },
  {
    title: 'Pointures Chaussures de Course',
    href: '/fr/pointure/pointure-chaussures-course/',
    badge: 'Running',
    desc: 'Quelle pointure choisir pour vos baskets de running ? Conseils podologiques pour éviter les frottements.',
    units: 'Chaussure Ville ⇄ Running',
  },
];

const portalFaq = [
  {
    question: "Qu'est-ce que SizeToolsHub ?",
    answer: "SizeToolsHub est la plateforme de référence internationale pour la conversion de tailles, gabarits et unités de mesure. Nous fournissons des calculatrices instantanées et des grilles officielles pour les souliers, le prêt-à-porter, la joaillerie et la cuisine."
  },
  {
    question: "Pourquoi les pointures et tailles diffèrent-elles entre pays ?",
    answer: "Chaque nation a développé ses propres échelles : les pays anglo-saxons mesurent en pouces et tiers de pouce, l'Europe continentale emploie le Point de Paris métrique, et des pays comme le Japon utilisent directement les centimètres."
  },
  {
    question: "Comment réussir ses achats en ligne sur des sites étrangers ?",
    answer: "Le moyen le plus infaillible consiste à prendre vos mensurations corporelles au mètre ruban en centimètres (longueur de pied pour les souliers, tours de poitrine, taille et bassin pour les vêtements) et de vous référer aux tableaux spécifiques de la marque."
  }
];
---

<BaseLayout
  title="SizeToolsHub Français — Convertisseur de Tailles et Pointures Internationales"
  description="Convertisseurs instantanés de pointures de chaussures, tailles de vêtements, sneakers de marque, bagues et dimensions. Normes officielles 2026 sans temps de chargement."
  lang="fr"
  isHomePage={true}
  faq={portalFaq}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <!-- Hero Section -->
    <header class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-canvas-soft border border-hairline-soft mb-6 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="text-xs font-semibold text-ink">Normes Internationales 2026</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-ink mb-6" style="line-height: 1.08;">
        Ne doutez plus jamais de votre taille.
      </h1>

      <p class="text-lg sm:text-xl text-text-muted font-light leading-relaxed mb-8">
        Conversions internationales exactes et instantanées sur plus de 450 marques mondiales, vêtements, souliers, joaillerie et gabarits quotidiens.
      </p>
    </header>

    <!-- Universal Converter Island -->
    <section class="mb-16 sm:mb-20">
      <UniversalConverter client:load />
    </section>

    <!-- Top Featured Conversions Grid -->
    <section class="mb-16 sm:mb-20">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
            Outils Populaires en Français
          </h2>
          <p class="text-sm text-text-muted font-light mt-1">
            Les convertisseurs les plus consultés pour commander sur les boutiques en ligne américaines et européennes.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featuredTools.map((tool) => (
          <a
            href={tool.href}
            class="group p-6 rounded-2xl bg-canvas border border-hairline-soft hover:border-hairline hover:-translate-y-1 transition-all duration-200 shadow-2xs hover:shadow-xs active:scale-[0.99] flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-accent/10 text-accent text-[11px] font-semibold">
                  {tool.badge}
                </span>
                <span class="text-xs text-text-faint group-hover:text-accent group-hover:translate-x-0.5 transition-all">
                  →
                </span>
              </div>
              <h3 class="text-lg font-bold text-ink mb-2 group-hover:text-accent transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs text-text-muted font-light leading-relaxed mb-4">
                {tool.desc}
              </p>
            </div>
            <div class="pt-3 border-t border-hairline-soft flex items-center justify-between text-[11px] text-text-faint">
              <span>{tool.units}</span>
              <span class="font-semibold text-accent group-hover:underline">Ouvrir ↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Categories Directory -->
    <section class="mb-16 sm:mb-20">
      <div class="mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Explorer par Catégorie
        </h2>
        <p class="text-sm text-text-muted font-light mt-1">
          Accédez à nos grilles d’étalonnage et à nos calculateurs spécialisés.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class="group p-6 rounded-3xl bg-canvas border border-hairline-soft hover:border-hairline hover:-translate-y-1 transition-all duration-200 shadow-2xs hover:shadow-xs flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl p-3 rounded-2xl bg-canvas-soft border border-hairline-soft inline-block">
                  {cat.icon}
                </span>
                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-field text-text-muted">
                  {cat.popularCount}
                </span>
              </div>
              <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-accent transition-colors">
                {cat.name}
              </h3>
              <p class="text-xs text-text-muted font-light leading-relaxed">
                {cat.desc}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-hairline-soft flex items-center justify-between text-xs font-semibold text-ink group-hover:text-accent transition-colors">
              <span>{cat.isLocalized ? 'Voir les Outils' : 'Guide Universel'}</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Portal FAQ -->
    <section class="mt-16 pt-12 border-t border-hairline-soft">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
          <span>Foire Aux Questions</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Tout Savoir sur les Tailles et Pointures.
        </h2>
        <p class="text-sm text-text-muted font-light mt-1 max-w-2xl">
          Réponses rapides pour acheteurs et vendeurs internationaux.
        </p>
      </div>

      <div class="space-y-4 max-w-3xl">
        {portalFaq.map((item) => (
          <details class="group p-5 rounded-2xl bg-canvas border border-hairline-soft transition-all duration-200 open:border-hairline">
            <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-ink cursor-pointer list-none focus:outline-none">
              <span>{item.question}</span>
              <span class="text-text-muted transition-transform duration-200 group-open:rotate-180">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-text-muted font-light leading-relaxed border-t border-hairline-soft pt-3">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
