---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShoeConverterIsland from '../../../components/ShoeConverterIsland';
import ShoeStaticTableFr from '../../../components/ShoeStaticTableFr.astro';
import PrintableChart from '../../../components/PrintableChart.astro';
import ShareableUrl from '../../../components/ShareableUrl.astro';
import CopyResultButton from '../../../components/CopyResultButton.astro';
import RelatedConverters from '../../../components/RelatedConverters.astro';

export async function getStaticPaths() {
  const entries = await getCollection('converters', ({ id, data }) =>
    id.startsWith('fr/pointure/') || data.converterType === 'pointure'
  );
  return entries.map((entry) => ({
    params: {
      slug: entry.id.replace(/^fr\/pointure\//, '').replace(/\.(json|md)$/, ''),
    },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'converters'>;
}

const { entry } = Astro.props;
const { slug } = Astro.params;
---

<BaseLayout
  title={`${entry.data.title} — Guide Officiel | SizeToolsHub`}
  description={entry.data.metaDescription}
  canonicalUrl={entry.data.canonicalUrl}
  faq={entry.data.faq}
  softwareAppName={entry.data.title}
  lang="fr"
>

  <!-- Breadcrumb Navigation Slot -->
  <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-text-muted pt-6 pb-2" aria-label="Breadcrumb">
    <a href="/fr/" class="hover:text-ink transition-colors">Accueil</a>
    <span>/</span>
    <a href="/fr/pointure/" class="hover:text-ink transition-colors">Pointure</a>
    <span>/</span>
    <span class="text-ink font-semibold truncate">{entry.data.title}</span>
  </nav>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- Header Section with exact target keyword as H1 -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-ink border border-hairline-soft">
          Calculateur de Pointure
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          Norme ISO 9407 & Point de Paris
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-field text-text-muted text-xs font-medium">
          {entry.data.fromUnit} ⇄ {entry.data.toUnit}
        </span>
        <CopyResultButton
          textToCopy={`${entry.data.title}: ${entry.data.fromUnit} vers ${entry.data.toUnit} sur SizeToolsHub.com`}
          label="Copier la Pointure"
          toastMessage="Guide de pointure copié !"
        />
      </div>

      <!-- Exact Target Keyword in H1 -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink mb-4" style="line-height: 1.1;">
        {entry.data.primaryKeyword}
      </h1>

      {entry.data.directAnswer && (
        <div class="p-5 sm:p-6 rounded-2xl bg-canvas-soft border border-hairline mb-6 max-w-3xl">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span class="text-[11px] font-bold uppercase tracking-wider text-accent">Réponse Directe</span>
          </div>
          <p class="text-base sm:text-lg text-ink font-medium leading-relaxed">
            {entry.data.directAnswer}
          </p>
        </div>
      )}

      <p class="text-base sm:text-lg text-text-muted font-light leading-relaxed max-w-3xl">
        {entry.data.metaDescription}
      </p>
    </header>

    <!-- Live Interactive Converter Island (Client Hydrated) -->
    <div class="mb-6">
      <ShoeConverterIsland
        client:load
        initialFromUnit={entry.data.fromUnit}
        initialToUnit={entry.data.toUnit}
        primaryKeyword={entry.data.primaryKeyword}
      />
    </div>

    <!-- Toolbar: Shareable URL & Printable Chart -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-16">
      <ShareableUrl
        title={entry.data.title}
        description={entry.data.metaDescription}
      />
      <PrintableChart
        chartTitle={entry.data.title}
        categoryName="Pointure de Chaussures"
      />
    </div>

    <!-- Static Reference Table (Zero-JS HTML Table for SEO & Quick Reference) -->
    <ShoeStaticTableFr />

    <!-- Practical Measurement & Shopping Guide -->
    <section class="mt-16 pt-12 border-t border-hairline-soft">
      <div class="mb-6">
        <h2 class="text-2xl font-bold tracking-tight text-ink">
          Comment mesurer précisément votre pied chez vous
        </h2>
        <p class="text-sm text-text-muted mt-1">
          Protocole recommandé par les bottiers et podologues pour un essayage parfait.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-canvas border border-hairline-soft space-y-3">
          <div class="w-8 h-8 rounded-full bg-accent/10 text-accent font-bold flex items-center justify-center text-sm">
            1
          </div>
          <h3 class="font-bold text-ink text-base">Feuille et Mur</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Posez une feuille de papier au sol contre un mur. Placez votre talon bien plaqué contre la plinthe en portant vos chaussettes ordinaires.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-canvas border border-hairline-soft space-y-3">
          <div class="w-8 h-8 rounded-full bg-accent/10 text-accent font-bold flex items-center justify-center text-sm">
            2
          </div>
          <h3 class="font-bold text-ink text-base">Tracé au Crayon</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Tracez un trait net devant l’orteil le plus avancé en tenant votre crayon bien perpendiculaire au papier pour ne pas fausser le contour.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-canvas border border-hairline-soft space-y-3">
          <div class="w-8 h-8 rounded-full bg-accent/10 text-accent font-bold flex items-center justify-center text-sm">
            3
          </div>
          <h3 class="font-bold text-ink text-base">Marge d’Aisance</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Mesurez la distance en millimètres. Ajoutez 5 à 8 mm pour des souliers de ville et 10 à 15 mm pour des chaussures de course à pied.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion Section -->
    {entry.data.faq && entry.data.faq.length > 0 && (
      <section class="mt-16 pt-12 border-t border-hairline-soft">
        <div class="mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
            <span>Foire Aux Questions</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
            Questions Fréquentes : {entry.data.primaryKeyword}.
          </h2>
          <p class="text-sm text-text-muted font-light mt-1 max-w-2xl">
            Réponses détaillées sur les spécificités des marques, le chaussant et les pointures internationales.
          </p>
        </div>

        <div class="space-y-4 max-w-3xl">
          {entry.data.faq.map((item) => (
            <details class="group p-5 rounded-2xl bg-canvas border border-hairline-soft transition-all duration-200 open:border-hairline">
              <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-ink cursor-pointer list-none focus:outline-none">
                <span>{item.question}</span>
                <span class="text-text-muted transition-transform duration-200 group-open:rotate-180">↓</span>
              </summary>
              <p class="mt-3 text-xs sm:text-sm text-text-muted font-light leading-relaxed border-t border-hairline-soft pt-3">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Contextual Internal Linking Grid (6-8 sibling converters) -->
    <RelatedConverters
      currentSlug={slug || ''}
      categorySlug="pointure"
      categoryName="Pointure"
      converterType="pointure"
      maxItems={8}
    />

  </main>
</BaseLayout>
