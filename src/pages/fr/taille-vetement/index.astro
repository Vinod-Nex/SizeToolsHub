---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ClothingConverterIsland from '../../../components/ClothingConverterIsland';
import ClothingStaticTableFr from '../../../components/ClothingStaticTableFr.astro';

// Query all French clothing converters
const entries = await getCollection('converters', ({ id, data }) =>
  id.startsWith('fr/taille-vetement/') || data.converterType === 'taille-vetement'
);

const tools = entries.map((entry) => ({
  slug: entry.id.replace(/^fr\/taille-vetement\//, '').replace(/\.(json|md)$/, ''),
  title: entry.data.title,
  primaryKeyword: entry.data.primaryKeyword,
  description: entry.data.metaDescription,
  fromUnit: entry.data.fromUnit,
  toUnit: entry.data.toUnit,
}));

const hubFaq = [
  {
    question: "Comment convertir les tailles de vêtements US en tailles françaises ?",
    answer: "Pour les femmes, ajoutez environ 32 à 34 à la taille américaine : US 2 = FR 36, US 4 = FR 38, US 6 = FR 40, US 8 = FR 42. Pour les costumes homme, ajoutez 10 (US 38 = FR 48)."
  },
  {
    question: "Que signifient les mentions W et L sur les jeans ?",
    answer: "'W' indique le tour de taille en pouces (Waist) et 'L' la longueur d'entrejambe (Length). Pour trouver votre taille française, ajoutez 10 au W : un jean W30 équivaut à un pantalon taille 40 en France."
  },
  {
    question: "Pourquoi les tailles de soutien-gorge françaises ont-elles 15 cm de plus qu'en Europe ?",
    answer: "La norme française AFNOR ajoute historiquement 15 cm au tour sous-buste réel : une femme mesurant 75 cm sous la poitrine fait du 90 en France, mais du 75 en Europe (EU) et du 34 aux États-Unis."
  },
  {
    question: "Quelle est la différence entre la taille française et la taille italienne ?",
    answer: "La taille italienne (IT) est généralement 4 chiffres plus haute que la taille française : un 38 français correspond à un 42 italien."
  }
];
---

<BaseLayout
  title="Guide des Tailles de Vêtements : France, Europe, US et UK — SizeToolsHub"
  description="Convertisseur officiel de tailles de vêtements féminins et masculins : France (FR), Europe (EU), États-Unis (US) et Royaume-Uni (UK). Robes, jeans, chemises et soutiens-gorge."
  lang="fr"
  faq={hubFaq}
>
  <!-- Breadcrumbs -->
  <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-text-muted pt-6 pb-2" aria-label="Breadcrumb">
    <a href="/fr/" class="hover:text-ink transition-colors">Accueil</a>
    <span>/</span>
    <span class="text-ink font-semibold">Taille Vêtement</span>
  </nav>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- Category Header -->
    <header class="mb-10 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-ink border border-hairline-soft">
          Guide de Prêt-à-Porter France
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          {entries.length} Outils Spécialisés
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink mb-4" style="line-height: 1.1;">
        Guide et Correspondance des Tailles de Vêtements : France, US et UK.
      </h1>

      <p class="text-base sm:text-lg text-text-muted font-light leading-relaxed">
        Trouvez instantanément votre taille sur les sites de vente en ligne internationaux comme ASOS, Zara, Shein ou Levi’s. Grilles morphologiques AFNOR et ISO pour robes, costumes, jeans et lingerie.
      </p>
    </header>

    <!-- Quick Live Interactive Converter Island -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs uppercase tracking-wider text-text-faint font-semibold">
          Calculateur de Vêtements en Temps Réel
        </h2>
        <span class="text-xs text-text-muted">Interactif</span>
      </div>
      <ClothingConverterIsland
        client:load
        initialFromUnit="US Size"
        initialToUnit="EU Size"
        primaryKeyword="Convertisseur de Taille de Vêtement"
      />
    </section>

    <!-- Sub-Tool Directory Grid -->
    <section class="mb-16" aria-labelledby="clothing-tools-heading">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
            <span>Pièces Spécifiques</span>
          </div>
          <h2 id="clothing-tools-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
            Répertoire des Convertisseurs de Vêtements.
          </h2>
          <p class="text-sm sm:text-base text-text-muted font-light mt-1">
            Sélectionnez la catégorie de vêtement souhaitée pour obtenir la correspondance immédiate.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tools.map((tool) => (
          <a
            href={`/fr/taille-vetement/${tool.slug}/`}
            class="group flex flex-col justify-between p-6 rounded-2xl bg-canvas border border-hairline-soft hover:border-hairline hover:-translate-y-1 transition-all duration-200 shadow-2xs hover:shadow-xs active:scale-[0.99]"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-accent/10 text-accent text-[11px] font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                  <span>{tool.fromUnit} ⇄ {tool.toUnit}</span>
                </span>
                <span class="text-xs text-text-faint group-hover:text-accent group-hover:translate-x-0.5 transition-all">
                  →
                </span>
              </div>
              <h3 class="text-lg font-bold text-ink mb-2 group-hover:text-accent transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs text-text-muted font-light leading-relaxed line-clamp-2">
                {tool.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-hairline-soft flex items-center justify-between text-[11px] text-text-faint">
              <span>{tool.primaryKeyword}</span>
              <span class="font-semibold text-accent group-hover:underline">Calculer ↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Static Reference Table Component -->
    <ClothingStaticTableFr />

    <!-- FAQ Section -->
    <section class="mt-16 pt-12 border-t border-hairline-soft">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
          <span>Foire Aux Questions</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Questions Fréquentes sur les Tailles de Vêtements.
        </h2>
        <p class="text-sm sm:text-base text-text-muted font-light mt-1 max-w-2xl">
          Conseils morphologiques pour prendre ses mensurations avec précision.
        </p>
      </div>

      <div class="space-y-4 max-w-3xl">
        {hubFaq.map((item) => (
          <details class="group p-5 rounded-2xl bg-canvas border border-hairline-soft transition-all duration-200 open:border-hairline">
            <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-ink cursor-pointer list-none focus:outline-none">
              <span>{item.question}</span>
              <span class="text-text-muted transition-transform duration-200 group-open:rotate-180">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-text-muted font-light leading-relaxed border-t border-hairline-soft pt-3">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
