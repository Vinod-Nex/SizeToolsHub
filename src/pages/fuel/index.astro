---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FuelConverterIsland from '../../components/FuelConverterIsland';
import FuelStaticTable from '../../components/FuelStaticTable.astro';

// Query all fuel economy converters
const entries = await getCollection('converters', ({ data }) => data.converterType === 'fuel');

const tools = entries.map((entry) => ({
  slug: entry.id.replace(/^fuel\//, '').replace(/\.(json|md)$/, ''),
  title: entry.data.title,
  primaryKeyword: entry.data.primaryKeyword,
  description: entry.data.metaDescription,
  fromUnit: entry.data.fromUnit,
  toUnit: entry.data.toUnit,
}));

const hubFaq = [
  {
    question: "How do you convert US MPG to Liters per 100km?",
    answer: "Divide 235.215 by the US MPG figure. For instance, 30 US MPG converts to 235.215 ÷ 30 = 7.84 L/100km. A car rated at 40 US MPG converts to 235.215 ÷ 40 = 5.88 L/100km."
  },
  {
    question: "Why is UK MPG higher than US MPG for the same car?",
    answer: "A British Imperial gallon is approximately 20% larger than a United States liquid gallon (4.546 Liters vs 3.785 Liters). Because an Imperial gallon contains more fuel volume, the vehicle travels further on a single UK gallon: 1 US MPG = 1.201 Imperial UK MPG."
  },
  {
    question: "How is road trip fuel cost calculated?",
    answer: "Divide the total route distance in miles by your car's highway MPG rating to find the gallons of fuel required. Multiply the gallons needed by the local gas price per gallon. For a 400-mile trip at 25 MPG with gas at $3.50/gal: (400 ÷ 25) × $3.50 = 16 gallons × $3.50 = $56.00."
  },
  {
    question: "How do you convert kilometers to miles in your head?",
    answer: "Multiply the kilometer figure by 6, then drop the zero or move the decimal point one place to the left. For example, 80 km × 6 = 480 → approximately 48 miles (exact: 49.7 miles). Alternatively, multiply by 0.62."
  }
];
---

<BaseLayout
  title="Fuel Economy & Gas Mileage Converters — SizeToolsHub"
  description="Convert between US MPG, European L/100km, British Imperial MPG, and km/L. Calculate road trip gas costs, fuel expenses, and kilometer-to-mile distances."
  faq={hubFaq}
>
  <!-- Breadcrumbs -->
  <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-text-muted pt-6 pb-2" aria-label="Breadcrumb">
    <a href="/" class="hover:text-ink transition-colors">Home</a>
    <span>/</span>
    <span class="text-ink font-semibold">Fuel Economy</span>
  </nav>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- Category Header -->
    <header class="mb-10 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-ink border border-hairline-soft">
          Category Hub
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          {entries.length} Specialized Converters
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink mb-4" style="line-height: 1.1;">
        Fuel Economy, Mileage & Road Trip Cost Calculators.
      </h1>

      <p class="text-base sm:text-lg text-text-muted font-light leading-relaxed">
        Understand the true cost of driving across borders. Accurately translate between North American Miles Per Gallon (MPG), European Liters per 100km (L/100km), British Imperial gallons, and calculate exact journey gas budgets.
      </p>
    </header>

    <!-- Quick Live Interactive Converter Island -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs uppercase tracking-wider text-text-faint font-semibold">
          Universal Automotive Fuel Engine
        </h2>
        <span class="text-xs text-text-muted">Interactive Calculator</span>
      </div>
      <FuelConverterIsland
        client:visible
        initialMode="economy"
        initialValue={30}
        initialFromUnit="mpg_us"
        initialToUnit="l_100km"
        primaryKeyword="Universal Fuel Economy Converter"
      />
    </section>

    <!-- Sub-Tool Directory Grid -->
    <section class="mb-16" aria-labelledby="tools-directory-heading">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
            <span>Specialized Calculators</span>
          </div>
          <h2 id="tools-directory-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
            Fuel & Mileage Tools Directory.
          </h2>
          <p class="text-sm sm:text-base text-text-muted font-light mt-1">
            Dedicated cross-border conversion utilities, trip budgeting tools, and distance tables.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {tools.map((tool) => (
          <a
            href={`/fuel/${tool.slug}/`}
            class="group p-6 rounded-3xl bg-canvas border border-hairline-soft hover:border-hairline hover:-translate-y-1 transition-all duration-200 shadow-2xs hover:shadow-xs flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-semibold text-accent px-2.5 py-0.5 rounded-full bg-accent/10">
                  {tool.fromUnit} ⇄ {tool.toUnit}
                </span>
                <span class="text-xs text-text-faint group-hover:text-ink transition-colors">→</span>
              </div>
              <h3 class="text-lg font-bold text-ink mb-2 group-hover:text-accent transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs sm:text-sm text-text-muted font-light leading-relaxed">
                {tool.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-hairline-soft flex items-center justify-between text-xs text-text-muted">
              <span>View Formula & Tool</span>
              <span class="font-medium text-ink group-hover:translate-x-0.5 transition-transform">Calculate →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Educational Guide: Understanding Fuel Metrics -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16" aria-label="Fuel Standards Guide">
      <div class="p-6 rounded-3xl bg-canvas border border-hairline-soft">
        <div class="w-10 h-10 rounded-2xl bg-accent/10 flex items-center justify-center text-accent mb-4 font-bold text-lg">
          235
        </div>
        <h3 class="text-base font-bold text-ink mb-2">The 235.215 Constant</h3>
        <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
          The magic conversion number 235.215 derives from the ratio between 100 kilometers (62.137 miles) and 1 US gallon (3.7854 Liters). Dividing 235.215 by MPG produces L/100km, and vice-versa.
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-canvas border border-hairline-soft">
        <div class="w-10 h-10 rounded-2xl bg-purple-500/10 flex items-center justify-center text-purple-600 dark:text-purple-400 mb-4 font-bold text-lg">
          +20%
        </div>
        <h3 class="text-base font-bold text-ink mb-2">Imperial Gallon Illusion</h3>
        <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
          UK vehicles appear to achieve dramatically superior MPG on paper. However, an Imperial gallon contains 4.546 Liters compared to the US gallon's 3.785 Liters. The vehicle burns the exact same volume of fuel.
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-canvas border border-hairline-soft">
        <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 flex items-center justify-center text-emerald-600 dark:text-emerald-400 mb-4 font-bold text-lg">
          $$$
        </div>
        <h3 class="text-base font-bold text-ink mb-2">The MPG Illusion</h3>
        <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
          Replacing a 15-MPG truck with a 20-MPG truck saves 1.67 gallons every 100 miles. But replacing a 40-MPG sedan with a 50-MPG hybrid only saves 0.50 gallons every 100 miles. Focus on low-economy vehicles for the biggest financial impact.
        </p>
      </div>
    </section>

    <!-- Static Reference Tables -->
    <FuelStaticTable />

    <!-- FAQ Accordion -->
    <section class="mt-16 pt-12 border-t border-hairline-soft" aria-labelledby="hub-faq-heading">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
          <span>Frequently Asked Questions</span>
        </div>
        <h2 id="hub-faq-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Expert Answers on Vehicle Fuel Efficiency.
        </h2>
        <p class="text-sm sm:text-base text-text-muted font-light mt-1">
          Essential insights into fuel consumption math, international metrics, and road trip expense planning.
        </p>
      </div>

      <div class="space-y-3">
        {hubFaq.map((item) => (
          <details class="group rounded-2xl bg-canvas border border-hairline-soft p-5 transition-colors cursor-pointer open:bg-canvas-soft/60">
            <summary class="flex items-center justify-between text-base font-semibold text-ink list-none select-none">
              <span>{item.question}</span>
              <span class="text-text-muted group-open:rotate-180 transition-transform duration-200">
                ↓
              </span>
            </summary>
            <p class="mt-4 text-sm text-text-muted leading-relaxed font-normal">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
