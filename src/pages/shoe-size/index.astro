---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShoeConverterIsland from '../../components/ShoeConverterIsland';
import ShoeStaticTable from '../../components/ShoeStaticTable.astro';

// Query all shoe-size converters
const entries = await getCollection('converters', ({ data }) => data.converterType === 'shoe-size');

const tools = entries.map((entry) => ({
  slug: entry.id.replace(/^shoe-size\//, '').replace(/\.(json|md)$/, ''),
  title: entry.data.title,
  primaryKeyword: entry.data.primaryKeyword,
  description: entry.data.metaDescription,
  fromUnit: entry.data.fromUnit,
  toUnit: entry.data.toUnit,
}));

const hubFaq = [
  {
    question: "How do I find my exact international shoe size?",
    answer: "The most reliable method is measuring your bare foot length in centimeters or millimeters (Mondopoint) from the heel to the tip of your longest toe in the afternoon, then matching it against our ISO 9407 conversion tables."
  },
  {
    question: "Why do shoe sizes differ across brands like Nike, Adidas, and New Balance?",
    answer: "While international standards exist, individual athletic and dress shoe manufacturers utilize proprietary foot molds (lasts). For example, Nike generally runs narrower (often a half size smaller for wide feet), while Adidas and New Balance offer truer-to-scale width toe-boxes."
  },
  {
    question: "What does shoe width letter coding mean (B, D, 2E, 4E)?",
    answer: "In the US, 'B' is standard women's width (narrow for men), 'D' is standard men's width (wide for women), '2E' is wide men's, and '4E' is extra wide men's. Measuring around the widest ball of your foot determines the proper width letter."
  },
  {
    question: "How much space should be left in the toe of a shoe?",
    answer: "A proper fit requires approximately 10mm to 15mm (about a thumbnail's width) between your longest toe and the end of the shoe to accommodate natural foot splay during walking or running."
  }
];
---

<BaseLayout
  title="International Shoe Size Converters & Global Fit Charts — SizeToolsHub"
  description="Convert shoe sizes across US, UK, European (EU / Paris points), Japanese (cm), and Mondopoint standards with exact fit calculations for Men, Women, and Kids."
  faq={hubFaq}
>
  <!-- Breadcrumbs -->
  <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-text-muted pt-6 pb-2" aria-label="Breadcrumb">
    <a href="/" class="hover:text-ink transition-colors">Home</a>
    <span>/</span>
    <span class="text-ink font-semibold">Shoe Size</span>
  </nav>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- Category Header -->
    <header class="mb-10 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-ink border border-hairline-soft">
          Category Hub
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          {entries.length} Dedicated Converters
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink mb-4" style="line-height: 1.1;">
        International Shoe Size Converters & Fit Charts.
      </h1>

      <p class="text-base sm:text-lg text-text-muted font-light leading-relaxed">
        Eliminate international sizing guesswork. Convert shoe sizes across US, UK, European (EU), and centimeter standards with ISO 9407 accuracy for Men, Women, and Kids.
      </p>
    </header>

    <!-- Quick Live Interactive Converter Island -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs uppercase tracking-wider text-text-faint font-semibold">
          Universal Footwear Engine
        </h2>
        <span class="text-xs text-text-muted">Interactive Calculator</span>
      </div>
      <ShoeConverterIsland
        client:visible
        initialFromUnit="US Size"
        initialToUnit="EU Size"
        primaryKeyword="International Shoe Size Converter"
      />
    </section>

    <!-- Sub-Tool Directory Grid -->
    <section class="mb-16" aria-labelledby="tools-directory-heading">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
            <span>Specialized Tools</span>
          </div>
          <h2 id="tools-directory-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
            Shoe Size Converters Directory.
          </h2>
          <p class="text-sm sm:text-base text-text-muted font-light mt-1">
            Dedicated converters optimized for specific regional standards and gender sizing.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tools.map((tool) => (
          <a
            href={`/shoe-size/${tool.slug}/`}
            class="group flex flex-col justify-between p-6 rounded-3xl bg-canvas border border-hairline-soft hover:border-hairline hover:-translate-y-1 transition-all duration-200 shadow-2xs hover:shadow-xs"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted">
                  {tool.fromUnit} ⇄ {tool.toUnit}
                </span>
                <span class="text-sm text-text-faint group-hover:text-accent font-bold transition-colors">
                  ↗
                </span>
              </div>
              <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-accent transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs sm:text-sm text-text-muted line-clamp-2 leading-relaxed mb-4">
                {tool.description}
              </p>
            </div>

            <div class="pt-4 border-t border-hairline-soft flex items-center justify-between text-xs">
              <span class="text-text-faint font-medium">Exact Formula Calcs</span>
              <span class="font-semibold text-ink group-hover:text-accent transition-colors">
                Launch tool →
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Footwear Measurement Guide Section -->
    <section class="mb-16 p-8 sm:p-10 rounded-3xl bg-canvas border border-hairline-soft">
      <div class="max-w-2xl mb-8">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold mb-3">
          Step-by-Step Measurement
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          How to Measure Your Feet Accurately.
        </h2>
        <p class="text-sm sm:text-base text-text-muted font-light mt-1">
          Take foot measurements in the late afternoon, as feet naturally expand during daytime activity.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-canvas-soft border border-hairline-soft">
          <div class="w-8 h-8 rounded-full bg-canvas flex items-center justify-center text-ink font-bold text-xs mb-3 shadow-2xs">
            01
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Tape Paper to Floor</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Tape a piece of blank paper firmly against a flat, straight wall on a hard surface (avoid thick carpet).
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-canvas-soft border border-hairline-soft">
          <div class="w-8 h-8 rounded-full bg-canvas flex items-center justify-center text-ink font-bold text-xs mb-3 shadow-2xs">
            02
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Trace Your Longest Toe</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Stand upright with your heel touching the wall. Mark the tip of your longest toe (often the big or second toe) with a pencil held vertically.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-canvas-soft border border-hairline-soft">
          <div class="w-8 h-8 rounded-full bg-canvas flex items-center justify-center text-ink font-bold text-xs mb-3 shadow-2xs">
            03
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Measure in Millimeters</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Use a rigid ruler to measure the distance in millimeters from the edge of the paper to your mark. That is your Mondopoint length.
          </p>
        </div>
      </div>
    </section>

    <!-- Static International Size Comparison Table -->
    <ShoeStaticTable />

    <!-- FAQ Accordion -->
    <section class="mt-16 pt-12 border-t border-hairline-soft" aria-labelledby="hub-faq-heading">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
          <span>Footwear FAQ</span>
        </div>
        <h2 id="hub-faq-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Frequently Asked Questions About Shoe Sizing.
        </h2>
        <p class="text-sm sm:text-base text-text-muted font-light mt-1">
          Everything you need to know before ordering footwear across borders.
        </p>
      </div>

      <div class="space-y-3">
        {hubFaq.map((item) => (
          <details class="group rounded-2xl bg-canvas border border-hairline-soft p-5 transition-colors cursor-pointer open:bg-canvas-soft/60">
            <summary class="flex items-center justify-between text-base font-semibold text-ink list-none select-none">
              <span>{item.question}</span>
              <span class="text-text-muted group-open:rotate-180 transition-transform duration-200">
                ↓
              </span>
            </summary>
            <p class="mt-4 text-sm text-text-muted leading-relaxed font-normal">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
