---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DataConverterIsland from '../../components/DataConverterIsland';
import DataStaticTable from '../../components/DataStaticTable.astro';

// Query all data storage converters
const entries = await getCollection('converters', ({ data }) => data.converterType === 'data');

const tools = entries.map((entry) => ({
  slug: entry.id.replace(/^data\//, '').replace(/\.(json|md)$/, ''),
  title: entry.data.title,
  primaryKeyword: entry.data.primaryKeyword,
  description: entry.data.metaDescription,
  fromUnit: entry.data.fromUnit,
  toUnit: entry.data.toUnit,
}));

const hubFaq = [
  {
    question: "Why does my 1TB hard drive show as only 931 GB in Windows?",
    answer: "Hard drive manufacturers calculate capacity using the decimal SI standard (1 TB = 1,000,000,000,000 bytes). Microsoft Windows measures storage using the binary IEC standard (1 TiB = 1,024³ bytes), but mislabels it as 'GB'. Dividing 1 trillion bytes by 1,073,741,824 yields approximately 931.32 GiB."
  },
  {
    question: "What is the difference between KB and KiB?",
    answer: "KB (Kilobyte) is a decimal unit equal to 1,000 bytes (10³). KiB (Kibibyte) is a binary unit established by the International Electrotechnical Commission (IEC) equal to 1,024 bytes (2¹⁰)."
  },
  {
    question: "What is the difference between Mbps and MB/s?",
    answer: "Mbps (Megabits per second) measures network speed and bandwidth. MB/s (Megabytes per second) measures file download and write rate. Because 8 bits equal 1 byte, a 100 Mbps internet connection downloads at a maximum theoretical speed of 12.5 MB/s."
  },
  {
    question: "How many gigabytes are in a terabyte?",
    answer: "In the decimal system used by hard drive makers, 1 Terabyte (TB) equals exactly 1,000 Gigabytes (GB). In the binary system used by computer operating systems, 1 Tebibyte (TiB) equals 1,024 Gibibytes (GiB)."
  }
];
---

<BaseLayout
  title="Digital Data Storage & Download Time Converters — SizeToolsHub"
  description="Convert digital data storage units between Bytes, KB, MB, GB, and TB with both decimal (SI 1000) and binary (IEC 1024) standards, plus download time calculators."
  faq={hubFaq}
>
  <!-- Breadcrumbs -->
  <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-text-muted pt-6 pb-2" aria-label="Breadcrumb">
    <a href="/" class="hover:text-ink transition-colors">Home</a>
    <span>/</span>
    <span class="text-ink font-semibold">Data Storage</span>
  </nav>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- Category Header -->
    <header class="mb-10 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-ink border border-hairline-soft">
          Category Hub
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          {entries.length} Dedicated Converters
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink mb-4" style="line-height: 1.1;">
        Digital Data Storage & Bandwidth Calculators.
      </h1>

      <p class="text-base sm:text-lg text-text-muted font-light leading-relaxed">
        Understand the real math behind your storage drives and network connections. Accurately translate between Decimal (SI / 1000) and Binary (IEC / 1024) memory standards, or calculate exact file download times.
      </p>
    </header>

    <!-- Quick Live Interactive Converter Island -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs uppercase tracking-wider text-text-faint font-semibold">
          Universal Data Sizing Engine
        </h2>
        <span class="text-xs text-text-muted">Interactive Calculator</span>
      </div>
      <DataConverterIsland
        client:visible
        initialFromUnit="GB"
        initialToUnit="MB"
        primaryKeyword="Universal Data Storage Converter"
      />
    </section>

    <!-- Sub-Tool Directory Grid -->
    <section class="mb-16" aria-labelledby="tools-directory-heading">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
            <span>Specialized Tools</span>
          </div>
          <h2 id="tools-directory-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
            Data Storage Converters Directory.
          </h2>
          <p class="text-sm sm:text-base text-text-muted font-light mt-1">
            Dedicated converters, file size calculators, and network transfer estimators.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tools.map((tool) => (
          <a
            href={`/data/${tool.slug}/`}
            class="group flex flex-col justify-between p-6 rounded-3xl bg-canvas border border-hairline-soft hover:border-hairline hover:-translate-y-1 transition-all duration-200 shadow-2xs hover:shadow-xs"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted">
                  {tool.fromUnit} ⇄ {tool.toUnit}
                </span>
                <span class="text-sm text-text-faint group-hover:text-accent font-bold transition-colors">
                  ↗
                </span>
              </div>
              <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-accent transition-colors">
                {tool.title}
              </h3>
              <p class="text-xs sm:text-sm text-text-muted line-clamp-2 leading-relaxed mb-4">
                {tool.description}
              </p>
            </div>

            <div class="pt-4 border-t border-hairline-soft flex items-center justify-between text-xs">
              <span class="text-text-faint font-medium">IEEE 1541 Verified</span>
              <span class="font-semibold text-ink group-hover:text-accent transition-colors">
                Launch tool →
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Storage Standards Architecture Guide -->
    <section class="mb-16 p-8 sm:p-10 rounded-3xl bg-canvas border border-hairline-soft">
      <div class="max-w-2xl mb-8">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold mb-3">
          Architecture & Standards
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          The Binary (IEC) vs Decimal (SI) Difference.
        </h2>
        <p class="text-sm sm:text-base text-text-muted font-light mt-1">
          Why hard drives never appear to have the full advertised space when plugged into a PC.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-canvas-soft border border-hairline-soft">
          <div class="w-8 h-8 rounded-full bg-canvas flex items-center justify-center text-ink font-bold text-xs mb-3 shadow-2xs">
            01
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Manufacturer Math (SI)</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Storage manufacturers (WD, Seagate, SanDisk, Samsung) sell products in powers of 10. A 1 TB drive has 1,000,000,000,000 bytes.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-canvas-soft border border-hairline-soft">
          <div class="w-8 h-8 rounded-full bg-canvas flex items-center justify-center text-ink font-bold text-xs mb-3 shadow-2xs">
            02
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">Operating System Math (IEC)</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Windows addresses storage in powers of 2 (1,024³ bytes per GiB). Dividing 1 trillion bytes by 1,073,741,824 yields 931.32 GiB.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-canvas-soft border border-hairline-soft">
          <div class="w-8 h-8 rounded-full bg-canvas flex items-center justify-center text-ink font-bold text-xs mb-3 shadow-2xs">
            03
          </div>
          <h3 class="text-base font-bold text-ink mb-1.5">macOS vs Windows</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Apple switched macOS (Mac OS X Snow Leopard+) to decimal base 1,000, so a 1 TB drive displays as a full 1.0 TB on a Mac.
          </p>
        </div>
      </div>
    </section>

    <!-- Static International Size Comparison Table -->
    <DataStaticTable />

    <!-- FAQ Accordion -->
    <section class="mt-16 pt-12 border-t border-hairline-soft" aria-labelledby="hub-faq-heading">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
          <span>Data FAQ</span>
        </div>
        <h2 id="hub-faq-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Frequently Asked Questions About Digital Storage.
        </h2>
        <p class="text-sm sm:text-base text-text-muted font-light mt-1">
          Everything you need to know about hard drive space, file sizes, and download speeds.
        </p>
      </div>

      <div class="space-y-3">
        {hubFaq.map((item) => (
          <details class="group rounded-2xl bg-canvas border border-hairline-soft p-5 transition-colors cursor-pointer open:bg-canvas-soft/60">
            <summary class="flex items-center justify-between text-base font-semibold text-ink list-none select-none">
              <span>{item.question}</span>
              <span class="text-text-muted group-open:rotate-180 transition-transform duration-200">
                ↓
              </span>
            </summary>
            <p class="mt-4 text-sm text-text-muted leading-relaxed font-normal">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
