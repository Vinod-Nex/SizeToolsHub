---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShoeConverterIsland from '../../../components/ShoeConverterIsland';
import ShoeStaticTablePtBr from '../../../components/ShoeStaticTablePtBr.astro';
import PrintableChart from '../../../components/PrintableChart.astro';
import ShareableUrl from '../../../components/ShareableUrl.astro';
import CopyResultButton from '../../../components/CopyResultButton.astro';
import RelatedConverters from '../../../components/RelatedConverters.astro';

export async function getStaticPaths() {
  const entries = await getCollection('converters', ({ id, data }) =>
    id.startsWith('pt-br/tamanho-calcado/') || data.converterType === 'tamanho-calcado'
  );
  return entries.map((entry) => ({
    params: {
      slug: entry.id.replace(/^pt-br\/tamanho-calcado\//, '').replace(/\.(json|md)$/, ''),
    },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'converters'>;
}

const { entry } = Astro.props;
const { slug } = Astro.params;
---

<BaseLayout
  title={`${entry.data.title} — Tabelas Internacionais | SizeToolsHub`}
  description={entry.data.metaDescription}
  canonicalUrl={entry.data.canonicalUrl}
  faq={entry.data.faq}
  softwareAppName={entry.data.title}
  lang="pt-br"
>

  <!-- Breadcrumb Navigation Slot -->
  <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-text-muted pt-6 pb-2" aria-label="Breadcrumb">
    <a href="/pt-br/" class="hover:text-ink transition-colors">Início</a>
    <span>/</span>
    <a href="/pt-br/tamanho-calcado/" class="hover:text-ink transition-colors">Tamanho de Calçado</a>
    <span>/</span>
    <span class="text-ink font-semibold truncate">{entry.data.title}</span>
  </nav>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- Header Section with exact target keyword as H1 -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-ink border border-hairline-soft">
          Calculadora de Calçados
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          Padrão ISO 9407 / Brasil
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-field text-text-muted text-xs font-medium">
          {entry.data.fromUnit} ⇄ {entry.data.toUnit}
        </span>
        <CopyResultButton
          textToCopy={`${entry.data.title}: ${entry.data.fromUnit} para ${entry.data.toUnit} no SizeToolsHub.com`}
          label="Copiar Guia"
          toastMessage="Guia de calçados copiado!"
        />
      </div>

      <!-- Exact Target Keyword in H1 -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink mb-4" style="line-height: 1.1;">
        {entry.data.primaryKeyword}
      </h1>

      {entry.data.directAnswer && (
        <div class="p-5 sm:p-6 rounded-2xl bg-canvas-soft border border-hairline mb-6 max-w-3xl">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span class="text-[11px] font-bold uppercase tracking-wider text-accent">Resposta Rápida</span>
          </div>
          <p class="text-base sm:text-lg text-ink font-medium leading-relaxed">
            {entry.data.directAnswer}
          </p>
        </div>
      )}

      <p class="text-base sm:text-lg text-text-muted font-light leading-relaxed max-w-3xl">
        {entry.data.metaDescription}
      </p>
    </header>

    <!-- Live Interactive Converter Island (Client Hydrated) -->
    <div class="mb-6">
      <ShoeConverterIsland
        client:load
        initialFromUnit={entry.data.fromUnit}
        initialToUnit={entry.data.toUnit}
        primaryKeyword={entry.data.primaryKeyword}
      />
    </div>

    <!-- Shareable URL Bar -->
    <ShareableUrl category="Tamanho de Calçado" />

    <!-- Quick Reference Calculation Guide in Portuguese -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-14" aria-label="Regras Rápidas de Tamanho">
      <div class="p-5 rounded-2xl bg-canvas border border-hairline-soft">
        <span class="text-[11px] font-bold uppercase tracking-wider text-accent">Regra Brasil x Europa</span>
        <h3 class="text-sm font-bold text-ink mt-1 mb-1.5">BR = EU − 2 Números</h3>
        <p class="text-xs text-text-muted leading-relaxed">
          O sistema brasileiro é baseado no ponto francês com subtração de 2 números. Se você calça 40 no Brasil, o seu tamanho na Europa é 42.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-canvas border border-hairline-soft">
        <span class="text-[11px] font-bold uppercase tracking-wider text-accent">Medida em Centímetros</span>
        <h3 class="text-sm font-bold text-ink mt-1 mb-1.5">Consulte 'CM' ou 'JP'</h3>
        <p class="text-xs text-text-muted leading-relaxed">
          Para não errar na compra de tênis importados da Nike, Adidas ou Asics, confira a medida em centímetros (CM) na etiqueta interna.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-canvas border border-hairline-soft">
        <span class="text-[11px] font-bold uppercase tracking-wider text-accent">Folga para Caminhada</span>
        <h3 class="text-sm font-bold text-ink mt-1 mb-1.5">Folga Frontal de 10mm</h3>
        <p class="text-xs text-text-muted leading-relaxed">
          Recomenda-se deixar aproximadamente a largura de uma unha (10 a 15 mm) entre o dedo mais longo e o bico do calçado para evitar pressão nos dedos.
        </p>
      </div>
    </section>

    <!-- Static Conversion Table with Print Optimization -->
    <PrintableChart
      title={`${entry.data.title} — Tabela de Referência`}
      subtitle="Padrões Calibrados ISO 9407 Mondopoint e Numerações Brasil / EUA / Europa"
      category="Tamanho de Calçado"
    >
      <ShoeStaticTablePtBr />
    </PrintableChart>

    <!-- FAQ Accordion Section in Portuguese -->
    {entry.data.faq && entry.data.faq.length > 0 && (
      <section class="mt-16 pt-12 border-t border-hairline-soft" aria-labelledby="faq-heading">
        <div class="mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
            <span>Perguntas Frequentes</span>
          </div>
          <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
            Perguntas Frequentes sobre Medidas de Calçados.
          </h2>
          <p class="text-sm sm:text-base text-text-muted font-light mt-1">
            Respostas práticas sobre numerações de calçados importados, diferenças entre marcas e como medir o pé.
          </p>
        </div>

        <div class="space-y-3">
          {entry.data.faq.map((item) => (
            <details class="group rounded-2xl bg-canvas border border-hairline-soft p-5 transition-colors cursor-pointer open:bg-canvas-soft/60">
              <summary class="flex items-center justify-between text-base font-semibold text-ink list-none select-none">
                <span>{item.question}</span>
                <span class="text-text-muted group-open:rotate-180 transition-transform duration-200">
                  ↓
                </span>
              </summary>
              <p class="mt-4 text-sm text-text-muted leading-relaxed font-normal">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Converters Component -->
    <RelatedConverters
      currentSlug={slug!}
      categorySlug="tamanho-calcado"
      categoryName="Tamanho de Calçado"
    />

  </main>
</BaseLayout>
