---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UniversalConverter from '../../components/UniversalConverter';
import { getCollection } from 'astro:content';

const ptBrShoeConverters = await getCollection('converters', ({ id }) =>
  id.startsWith('pt-br/tamanho-calcado/')
);
const ptBrClothingConverters = await getCollection('converters', ({ id }) =>
  id.startsWith('pt-br/tamanho-roupa/')
);

const categories = [
  {
    name: 'Tamanho de Calçado',
    href: '/pt-br/tamanho-calcado/',
    desc: 'Conversão oficial entre Brasil (BR), EUA (US), Europa (EU) e centímetros (CM). Guias de marcas como Nike, Adidas, Asics e Vans.',
    icon: '👟',
    popularCount: `${ptBrShoeConverters.length} Ferramentas`,
    isLocalized: true,
  },
  {
    name: 'Tamanho de Roupa',
    href: '/pt-br/tamanho-roupa/',
    desc: 'Tabelas completas de manequins (PP ao XG / 34 ao 54), calças jeans importadas (cintura W), vestidos, ternos e sutiãs.',
    icon: '👕',
    popularCount: `${ptBrClothingConverters.length} Ferramentas`,
    isLocalized: true,
  },
  {
    name: 'Tamanho de Anel',
    href: '/ring-size/',
    desc: 'Diâmetro interno, circunferência e numerações de alianças e anéis com escala 1:1 para impressão.',
    icon: '💍',
    popularCount: 'Guia Escala 1:1',
    isLocalized: false,
  },
  {
    name: 'Culinária e Receitas',
    href: '/cooking/',
    desc: 'Converta xícaras americanas (cups), colheres e onças fluidas para gramas (g) e mililitros (ml).',
    icon: '🥣',
    popularCount: 'Grama Precisa',
    isLocalized: false,
  },
  {
    name: 'Armazenamento de Dados',
    href: '/data/',
    desc: 'Calculadora de Bytes, Kilobytes, Megabytes, Gigabytes (GB) e Terabytes (TB) decimal e binário.',
    icon: '💾',
    popularCount: 'GB ↔ TB',
    isLocalized: false,
  },
  {
    name: 'Dimensões de Papel',
    href: '/paper-size/',
    desc: 'Padrão ISO 216 (A4, A3, A5), Carta (US Letter), Ofício e dimensões para impressão e molduras.',
    icon: '📄',
    popularCount: 'ISO 216 & Carta',
    isLocalized: false,
  },
  {
    name: 'Consumo de Combustível',
    href: '/fuel/',
    desc: 'Converta MPG (Milhas por Galão) para km/L e Litros por 100km (L/100km) para veículos importados.',
    icon: '⛽',
    popularCount: 'MPG ↔ km/L',
    isLocalized: false,
  },
];

const featuredTools = [
  {
    title: 'Calçados EUA para Brasil',
    href: '/pt-br/tamanho-calcado/eua-para-brasil/',
    badge: 'Mais Acessado',
    desc: 'Descubra qual é o seu número de tênis nos EUA (US Men e US Women) para o padrão brasileiro.',
    units: 'EUA (US) ⇄ Brasil (BR)',
  },
  {
    title: 'Calçados Brasil para EUA',
    href: '/pt-br/tamanho-calcado/brasil-para-eua/',
    badge: 'Compras nos EUA',
    desc: 'Vai comprar tênis na Amazon americana ou em outlets nos EUA? Converta sua numeração brasileira.',
    units: 'Brasil (BR) ⇄ EUA (US)',
  },
  {
    title: 'Roupas EUA para Brasil',
    href: '/pt-br/tamanho-roupa/eua-para-brasil-roupas/',
    badge: 'Vestuário',
    desc: 'Equivalência exata entre manequins norte-americanos e brasileiros masculinos e femininos.',
    units: 'EUA (US) ⇄ Brasil (BR)',
  },
  {
    title: 'Calça Jeans: Polegadas para BR',
    href: '/pt-br/tamanho-roupa/conversor-tamanho-calca-jeans/',
    badge: 'Jeans Levi\'s & GAP',
    desc: 'Entenda a medida W (cintura em polegadas) das calças importadas e ache seu número 38, 40, 42.',
    units: 'Cintura W (in) ⇄ Tamanho BR',
  },
  {
    title: 'Tabela de Tênis Nike',
    href: '/pt-br/tamanho-calcado/tabela-tamanhos-nike/',
    badge: 'Guia de Marca',
    desc: 'Tabela oficial de calçados Nike com correspondência de centímetros e numerações BR e US.',
    units: 'Nike BR ⇄ US ⇄ CM',
  },
  {
    title: 'Tabela de Sutiã Internacional',
    href: '/pt-br/tamanho-roupa/tabela-tamanhos-sutia/',
    badge: 'Lingerie',
    desc: 'Como medir costas e taça (A, B, C, D) para acertar no sutiã importado dos EUA e Europa.',
    units: 'Costas + Taça ⇄ Brasil (BR)',
  },
];

const homeFaq = [
  {
    question: "Como funciona a diferença entre o número de calçado no Brasil e na Europa?",
    answer: "O Brasil utiliza o sistema de Ponto Francês com defasagem de 2 números: a numeração brasileira é sempre dois números menor que a europeia (BR = EU - 2). Portanto, quem calça 40 no Brasil usa tamanho 42 na Europa (EU 42 = BR 40)."
  },
  {
    question: "Como comprar tênis nos Estados Unidos sem errar o tamanho?",
    answer: "A forma mais segura é olhar a etiqueta de um tênis confortável que você já possui e conferir a medida em centímetros (CM ou JP). Se preferir converter diretamente, lembre-se de que os tamanhos masculinos dos EUA costumam ser cerca de 31 a 32 números menores que o Brasil (US 9 masc = 40 BR) e os femininos cerca de 29 números menores (US 7 fem = 36 BR)."
  },
  {
    question: "O que significam as letras PP, P, M, G, GG em marcas importadas?",
    answer: "Nos EUA e marcas globais, a equivalência usual é: XS = PP, S = P, M = M, L = G, XL = GG e XXL = XG. Fique atento pois o corte americano tradicional (Regular Fit) é ligeiramente mais largo que a modelagem habitual no Brasil."
  }
];
---

<BaseLayout
  title="Tabelas de Conversão de Tamanhos: Brasil, EUA e Europa — SizeToolsHub"
  description="Conversores de tamanhos e tabelas para compras internacionais. Converta calçados, roupas, calças jeans e medidas entre Brasil (BR), EUA (US) e Europa (EU)."
  lang="pt-br"
  isHomePage={true}
  faq={homeFaq}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">

    <!-- Hero Header -->
    <section class="max-w-3xl mx-auto text-center mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-accent/10 border border-accent/20 text-accent text-xs font-semibold mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        <span>Padrões de Medidas Brasil & Internacional 2026</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-ink mb-5" style="line-height: 1.05;">
        Nunca mais erre o seu tamanho em compras internacionais.
      </h1>

      <p class="text-base sm:text-lg text-text-muted font-light leading-relaxed max-w-2xl mx-auto">
        Tabelas completas e calculadoras instantâneas entre o padrão brasileiro (BR), Estados Unidos (US), Europa (EU) e Reino Unido (UK) para calçados, roupas, calças jeans e mais.
      </p>
    </section>

    <!-- Master Tool Island: Universal Converter -->
    <div class="mb-20 sm:mb-28">
      <UniversalConverter client:load />
    </div>

    <!-- Featured Portuguese Converters Grid -->
    <section class="mb-20">
      <div class="flex items-center justify-between mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3 border border-hairline-soft">
            <span>Mais Utilizadas no Brasil</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">
            Ferramentas Populares para Compras no Exterior.
          </h2>
          <p class="text-sm text-text-muted font-light mt-1">
            Conversores diretos para as dúvidas mais frequentes de quem compra em sites internacionais
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {featuredTools.map((tool) => (
          <a
            href={tool.href}
            class="group flex flex-col justify-between p-6 rounded-3xl bg-canvas border border-hairline-soft hover:border-hairline transition-all duration-200 hover:-translate-y-1 shadow-2xs hover:shadow-xs active:scale-[0.99]"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-accent/10 text-accent text-[11px] font-semibold">
                  {tool.badge}
                </span>
                <span class="text-xs text-text-faint group-hover:text-accent group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all font-bold">
                  ↗
                </span>
              </div>

              <div class="mb-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-field text-[11px] font-semibold text-text-muted">
                  {tool.units}
                </span>
              </div>

              <h3 class="text-lg font-bold text-ink mb-2 group-hover:text-accent transition-colors leading-snug">
                {tool.title}
              </h3>

              <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-normal">
                {tool.desc}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-hairline-soft flex items-center justify-between text-xs font-semibold text-ink group-hover:text-accent transition-colors">
              <span>Abrir Conversor</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Category Hubs Grid -->
    <section class="mb-20">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">
            Categorias Especializadas.
          </h2>
          <p class="text-sm text-text-muted font-light mt-1">
            Navegue pelos diretórios completos com tabelas comparativas detalhadas
          </p>
        </div>
        <span class="text-xs text-accent font-semibold uppercase tracking-wider hidden sm:inline-block">
          Foco em Calçados & Roupas
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class={`group block p-7 rounded-3xl bg-canvas border transition-all duration-200 hover:-translate-y-1 shadow-2xs ${
              cat.isLocalized ? 'border-accent/30 hover:border-accent' : 'border-hairline-soft hover:border-hairline'
            }`}
          >
            <div class="flex items-center justify-between mb-5">
              <span class="text-3xl">{cat.icon}</span>
              <span class={`px-2.5 py-1 rounded-full text-[11px] font-semibold ${
                cat.isLocalized ? 'bg-accent/10 text-accent' : 'bg-canvas-soft text-text-muted'
              }`}>
                {cat.popularCount}
              </span>
            </div>

            <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-accent transition-colors">
              {cat.name}
            </h3>

            <p class="text-sm text-text-muted font-normal leading-relaxed mb-6">
              {cat.desc}
            </p>

            <div class="flex items-center text-xs font-semibold text-ink group-hover:text-accent transition-colors">
              <span>Acessar Categoria</span>
              <span class="ml-1 group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Shopping Cross-Border Advisory Box -->
    <section class="p-8 sm:p-12 rounded-3xl bg-canvas-soft border border-hairline-soft mb-16 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-xl space-y-3">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-accent text-white text-xs font-semibold">
          Guia de Compras Internacionais
        </span>
        <h3 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">
          Comprando na Amazon US, Shein ou AliExpress?
        </h3>
        <p class="text-sm text-text-muted leading-relaxed">
          Evite devoluções e taxas extras conferindo sempre as medidas em centímetros (CM) na descrição do produto antes de finalizar o pedido. Use nosso conversor de calçados e manequins para comprar com 100% de segurança.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0">
        <a
          href="/pt-br/tamanho-calcado/eua-para-brasil/"
          class="w-full sm:w-auto px-6 py-3 rounded-full bg-primary text-on-primary text-sm font-semibold hover:opacity-90 transition-opacity text-center"
        >
          Converter Calçados EUA ⇄ Brasil
        </a>
      </div>
    </section>

    <!-- FAQ Accordion Section -->
    <section class="mb-16 pt-10 border-t border-hairline-soft" aria-labelledby="home-faq-heading">
      <div class="mb-8">
        <h2 id="home-faq-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Perguntas Frequentes sobre Conversões no Brasil.
        </h2>
        <p class="text-sm sm:text-base text-text-muted font-light mt-1">
          Informações essenciais para quem precisa converter medidas internacionais.
        </p>
      </div>

      <div class="space-y-3">
        {homeFaq.map((item) => (
          <details class="group rounded-2xl bg-canvas border border-hairline-soft p-5 transition-colors cursor-pointer open:bg-canvas-soft/60">
            <summary class="flex items-center justify-between text-base font-semibold text-ink list-none select-none">
              <span>{item.question}</span>
              <span class="text-text-muted group-open:rotate-180 transition-transform duration-200">
                ↓
              </span>
            </summary>
            <p class="mt-4 text-sm text-text-muted leading-relaxed font-normal">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
