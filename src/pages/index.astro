---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalConverter from '../components/UniversalConverter';
import { getCollection } from 'astro:content';

const allConverters = await getCollection('converters');

const categories = [
  {
    name: 'Shoe Size',
    slug: 'shoe-size',
    desc: 'US, UK, EU, JP & Mondopoint footwear standards with brand-specific calibrations.',
    icon: '👟',
    popularCount: '450+ Brands',
  },
  {
    name: 'Clothing Size',
    slug: 'clothing-size',
    desc: 'International tops, dresses, suits, pants, and body measurement charts.',
    icon: '👕',
    popularCount: 'Men & Women',
  },
  {
    name: 'Ring Size',
    slug: 'ring-size',
    desc: 'Finger diameter, circumference, and international jewelry scales with calibration guide.',
    icon: '💍',
    popularCount: '1:1 Scale Guide',
  },
  {
    name: 'Cooking & Baking',
    slug: 'cooking',
    desc: 'Cups, tablespoons, and volumetric liquid units to grams and ounces.',
    icon: '🥣',
    popularCount: 'Precision Grams',
  },
  {
    name: 'Data Storage',
    slug: 'data',
    desc: 'Binary (1024 base-2) and decimal (1000 base-10) bytes, GB, and TB storage calculator.',
    icon: '💾',
    popularCount: 'GB ↔ TB',
  },
  {
    name: 'Paper & Frames',
    slug: 'paper-size',
    desc: 'ISO 216 (A0–A10), US Letter, Legal, and architectural blueprint dimensions.',
    icon: '📄',
    popularCount: 'ISO 216',
  },
  {
    name: 'Fuel Economy',
    slug: 'fuel',
    desc: 'Miles Per Gallon (US/UK) to Liters per 100km (L/100km) and trip cost estimator.',
    icon: '⛽',
    popularCount: 'MPG ↔ L/100km',
  },
];
---

<BaseLayout
  title="SizeToolsHub — Universal Size & Measurement Intelligence"
  description="Instant, zero-lag international size conversions across 450+ global brands, apparel lines, footwear standards, jewelry, and travel baggage dimensions."
  isHomePage={true}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <!-- Hero Header (DESIGN.md line 280-295 & 329-335) -->
    <section class="max-w-3xl mx-auto text-center mb-10 sm:mb-14">
      <!-- Badge: Commercial signal in electric blue accent -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-accent/10 border border-accent/20 text-accent text-xs font-semibold mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        <span>2026 International Fit Standards</span>
      </div>

      <!-- Headline: Saans 652 with Terminal Period -->
      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-ink mb-5" style="line-height: 1.05;">
        Never guess your size again.
      </h1>

      <!-- Subtitle: Body-lg 300 weight light -->
      <p class="text-base sm:text-lg text-text-muted font-light leading-relaxed max-w-2xl mx-auto">
        Instant, exact international size conversions across footwear, apparel lines, jewelry scales, units of measure, and culinary standards.
      </p>
    </section>

    <!-- Master Tool Island: client:load (Only dynamic client island on page) -->
    <div class="mb-20 sm:mb-28">
      <UniversalConverter client:load />
    </div>

    <!-- Category Hubs Grid (Static HTML) -->
    <section class="mb-20">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">
            Specialized Category Hubs.
          </h2>
          <p class="text-sm text-text-muted font-light mt-1">
            Deep-dive charts and dedicated calculators per category
          </p>
        </div>
        <span class="text-xs text-text-faint font-semibold uppercase tracking-wider hidden sm:inline-block">
          7 Categories Active
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map((cat) => (
          <a
            href={`/${cat.slug}/`}
            class="group block p-7 rounded-3xl bg-canvas border border-hairline-soft hover:border-hairline transition-all duration-200 hover:-translate-y-1 shadow-2xs"
          >
            <div class="flex items-center justify-between mb-5">
              <span class="text-3xl">{cat.icon}</span>
              <span class="px-2.5 py-1 rounded-full bg-canvas-soft text-[11px] font-semibold text-text-muted">
                {cat.popularCount}
              </span>
            </div>

            <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-accent transition-colors">
              {cat.name}
            </h3>

            <p class="text-sm text-text-muted font-normal leading-relaxed mb-6">
              {cat.desc}
            </p>

            <div class="flex items-center text-xs font-semibold text-ink group-hover:text-accent transition-colors">
              <span>Open Category Hub</span>
              <span class="ml-1 group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Highlighted Feature Strip: "My Size Card" Feature Pitch -->
    <section class="p-8 sm:p-12 rounded-3xl bg-canvas-soft border border-hairline-soft mb-16 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-xl space-y-3">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-accent text-white text-xs font-semibold">
          Zero Sign-Up Required
        </span>
        <h3 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">
          Keep your measurements in one place with My Size Card.
        </h3>
        <p class="text-sm text-text-muted leading-relaxed">
          Store your shoe, shirt, dress, and ring sizes in your browser with zero registration. Generate a shareable, digital size pass to shop effortlessly worldwide.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0">
        <a
          href="/shoe-size/us-to-eu/"
          class="w-full sm:w-auto px-6 py-3 rounded-full bg-primary text-on-primary text-sm font-semibold hover:opacity-90 transition-opacity text-center"
        >
          View Conversion Charts
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
