---
interface Props {
  textToCopy: string;
  label?: string;
  copiedLabel?: string;
  toastMessage?: string;
  variant?: 'pill' | 'outline' | 'ghost';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  textToCopy,
  label = 'Copy Result',
  copiedLabel = 'Copied!',
  toastMessage = 'Result copied to clipboard!',
  variant = 'pill',
  size = 'sm',
  class: className = '',
} = Astro.props;

const sizeClasses = size === 'sm' ? 'px-3 py-1.5 text-xs' : 'px-4 py-2 text-sm';

let variantClasses = '';
switch (variant) {
  case 'outline':
    variantClasses = 'bg-canvas border border-hairline text-ink hover:bg-canvas-soft hover:border-ink/20';
    break;
  case 'ghost':
    variantClasses = 'bg-transparent text-text-muted hover:text-ink hover:bg-canvas-soft';
    break;
  case 'pill':
  default:
    variantClasses = 'bg-canvas-soft border border-hairline-soft text-ink hover:bg-canvas hover:border-hairline shadow-2xs hover:shadow-xs';
    break;
}
---

<button
  type="button"
  class={`copy-result-btn inline-flex items-center justify-center gap-1.5 rounded-full font-semibold transition-all duration-150 active:scale-95 cursor-pointer select-none focus:outline-none focus-visible:ring-2 focus-visible:ring-accent ${sizeClasses} ${variantClasses} ${className}`}
  data-copy-text={textToCopy}
  data-copied-label={copiedLabel}
  data-original-label={label}
  data-toast-msg={toastMessage}
  title="Copy to clipboard"
  aria-label={label}
  aria-live="polite"
>
  <svg class="copy-icon w-3.5 h-3.5 text-text-muted transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
  </svg>
  <svg class="check-icon hidden w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
  </svg>
  <span class="btn-label">{label}</span>
</button>

<script>
  import { showToast } from '../lib/toast';

  function initCopyButtons() {
    const buttons = document.querySelectorAll('.copy-result-btn:not([data-initialized])');
    buttons.forEach((btn) => {
      btn.setAttribute('data-initialized', 'true');
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const text = btn.getAttribute('data-copy-text');
        const copiedLabel = btn.getAttribute('data-copied-label') || 'Copied!';
        const originalLabel = btn.getAttribute('data-original-label') || 'Copy';
        const toastMsg = btn.getAttribute('data-toast-msg') || 'Copied to clipboard!';
        const labelEl = btn.querySelector('.btn-label');
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');

        if (!text) return;

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
          } else {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
          }

          if (labelEl) labelEl.textContent = copiedLabel;
          btn.setAttribute('aria-label', copiedLabel);
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          btn.classList.add('text-accent');

          showToast(toastMsg);

          setTimeout(() => {
            if (labelEl) labelEl.textContent = originalLabel;
            btn.setAttribute('aria-label', originalLabel);
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            btn.classList.remove('text-accent');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy:', err);
        }
      });
    });
  }

  initCopyButtons();
  document.addEventListener('astro:page-load', initCopyButtons);
</script>
