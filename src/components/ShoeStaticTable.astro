---
/**
 * Static Shoe Size Conversion Reference Table (Below the fold)
 * Zero JavaScript, fully accessible, SEO-optimized table following DESIGN.md
 */

const adultRows = [
  { usMen: '6.0', usWomen: '7.5', uk: '5.5', eu: '38.5', cm: '24.0', in: '9.45', mondo: '240' },
  { usMen: '6.5', usWomen: '8.0', uk: '6.0', eu: '39.0', cm: '24.5', in: '9.65', mondo: '245' },
  { usMen: '7.0', usWomen: '8.5', uk: '6.5', eu: '40.0', cm: '25.0', in: '9.84', mondo: '250' },
  { usMen: '7.5', usWomen: '9.0', uk: '7.0', eu: '40.5', cm: '25.5', in: '10.04', mondo: '255' },
  { usMen: '8.0', usWomen: '9.5', uk: '7.5', eu: '41.0', cm: '26.0', in: '10.24', mondo: '260' },
  { usMen: '8.5', usWomen: '10.0', uk: '8.0', eu: '42.0', cm: '26.5', in: '10.43', mondo: '265' },
  { usMen: '9.0', usWomen: '10.5', uk: '8.5', eu: '42.5', cm: '27.0', in: '10.63', mondo: '270' },
  { usMen: '9.5', usWomen: '11.0', uk: '9.0', eu: '43.0', cm: '27.5', in: '10.83', mondo: '275' },
  { usMen: '10.0', usWomen: '11.5', uk: '9.5', eu: '44.0', cm: '28.0', in: '11.02', mondo: '280' },
  { usMen: '10.5', usWomen: '12.0', uk: '10.0', eu: '44.5', cm: '28.5', in: '11.22', mondo: '285' },
  { usMen: '11.0', usWomen: '12.5', uk: '10.5', eu: '45.0', cm: '29.0', in: '11.42', mondo: '290' },
  { usMen: '11.5', usWomen: '13.0', uk: '11.0', eu: '45.5', cm: '29.5', in: '11.61', mondo: '295' },
  { usMen: '12.0', usWomen: '13.5', uk: '11.5', eu: '46.0', cm: '30.0', in: '11.81', mondo: '300' },
  { usMen: '13.0', usWomen: '14.5', uk: '12.5', eu: '47.5', cm: '31.0', in: '12.20', mondo: '310' },
  { usMen: '14.0', usWomen: '15.5', uk: '13.5', eu: '48.5', cm: '32.0', in: '12.60', mondo: '320' },
];
---

<section class="mt-16 pt-12 border-t border-hairline-soft">
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
      <span>Reference Standards</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
      International Footwear Conversion Chart.
    </h2>
    <p class="text-sm sm:text-base text-text-muted font-light mt-1 max-w-2xl">
      Official cross-reference table comparing US, UK, European, and Japanese centimeter sizing according to ISO 9407 Mondopoint standards.
    </p>
  </div>

  <!-- Responsive Overflow Table Container (DESIGN.md compare-table spec) -->
  <div class="overflow-x-auto rounded-3xl border border-hairline-soft bg-canvas shadow-2xs">
    <table class="w-full text-left text-sm border-collapse">
      <thead>
        <tr class="border-b border-hairline-soft bg-canvas-soft text-xs font-bold uppercase tracking-wider text-text-muted">
          <th class="py-4 px-5">US Men</th>
          <th class="py-4 px-5">US Women</th>
          <th class="py-4 px-5">UK</th>
          <th class="py-4 px-5">EU (Paris Pt)</th>
          <th class="py-4 px-5">Foot Length (cm)</th>
          <th class="py-4 px-5">Foot Length (in)</th>
          <th class="py-4 px-5">Mondopoint (mm)</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-hairline-soft text-ink">
        {adultRows.map((row, idx) => (
          <tr class={`transition-colors hover:bg-canvas-soft/60 ${idx % 2 === 1 ? 'bg-canvas-soft/20' : 'bg-canvas'}`}>
            <td class="py-3.5 px-5 font-bold text-ink">{row.usMen}</td>
            <td class="py-3.5 px-5 font-semibold text-text-muted">{row.usWomen}</td>
            <td class="py-3.5 px-5 font-medium">{row.uk}</td>
            <td class="py-3.5 px-5 font-medium text-accent">{row.eu}</td>
            <td class="py-3.5 px-5 font-mono">{row.cm} cm</td>
            <td class="py-3.5 px-5 font-mono text-text-muted">{row.in}″</td>
            <td class="py-3.5 px-5 font-mono text-text-faint">{row.mondo}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
