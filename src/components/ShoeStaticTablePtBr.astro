---
/**
 * Tabela Estática de Conversão de Tamanhos de Calçados para o Brasil
 * Zero JavaScript, acessível e otimizada para SEO segundo DESIGN.md
 */

const adultRows = [
  { br: '34', usMen: '4.0', usWomen: '5.5', uk: '3.5', eu: '36.0', cm: '22.5', in: '8.86' },
  { br: '35', usMen: '5.0', usWomen: '6.5', uk: '4.5', eu: '37.0', cm: '23.5', in: '9.25' },
  { br: '36', usMen: '6.0', usWomen: '7.5', uk: '5.5', eu: '38.0', cm: '24.0', in: '9.45' },
  { br: '37', usMen: '6.5', usWomen: '8.0', uk: '6.0', eu: '39.0', cm: '24.5', in: '9.65' },
  { br: '38', usMen: '7.0', usWomen: '8.5', uk: '6.5', eu: '40.0', cm: '25.0', in: '9.84' },
  { br: '39', usMen: '8.0', usWomen: '9.5', uk: '7.5', eu: '41.0', cm: '26.0', in: '10.24' },
  { br: '40', usMen: '8.5', usWomen: '10.0', uk: '8.0', eu: '42.0', cm: '26.5', in: '10.43' },
  { br: '41', usMen: '9.5', usWomen: '11.0', uk: '9.0', eu: '43.0', cm: '27.5', in: '10.83' },
  { br: '42', usMen: '10.0', usWomen: '11.5', uk: '9.5', eu: '44.0', cm: '28.0', in: '11.02' },
  { br: '43', usMen: '11.0', usWomen: '12.5', uk: '10.5', eu: '45.0', cm: '29.0', in: '11.42' },
  { br: '44', usMen: '12.0', usWomen: '13.5', uk: '11.5', eu: '46.0', cm: '30.0', in: '11.81' },
  { br: '45', usMen: '13.0', usWomen: '14.5', uk: '12.5', eu: '47.0', cm: '30.5', in: '12.01' },
  { br: '46', usMen: '14.0', usWomen: '15.5', uk: '13.5', eu: '48.0', cm: '31.5', in: '12.40' },
];
---

<section class="mt-16 pt-12 border-t border-hairline-soft">
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
      <span>Tabela de Referência Oficial</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
      Tabela Comparativa de Tamanhos de Calçados: Brasil, EUA e Europa.
    </h2>
    <p class="text-sm sm:text-base text-text-muted font-light mt-1 max-w-2xl">
      Equivalência de numeração entre calçados brasileiros (BR), americanos (US Men / US Women), europeus (EU) e o comprimento do pé em centímetros calibrado por normas ISO 9407.
    </p>
  </div>

  <div class="overflow-x-auto rounded-3xl border border-hairline-soft bg-canvas shadow-2xs">
    <table class="w-full text-left text-sm border-collapse">
      <thead>
        <tr class="border-b border-hairline-soft bg-canvas-soft text-xs font-bold uppercase tracking-wider text-text-muted">
          <th class="py-4 px-5 text-accent">Brasil (BR)</th>
          <th class="py-4 px-5">EUA Masc (US)</th>
          <th class="py-4 px-5">EUA Fem (US)</th>
          <th class="py-4 px-5">Reino Unido (UK)</th>
          <th class="py-4 px-5">Europa (EU)</th>
          <th class="py-4 px-5">Comprimento do Pé</th>
          <th class="py-4 px-5">Polegadas</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-hairline-soft text-ink">
        {adultRows.map((row, idx) => (
          <tr class={`transition-colors hover:bg-canvas-soft/60 ${idx % 2 === 1 ? 'bg-canvas-soft/20' : 'bg-canvas'}`}>
            <td class="py-3.5 px-5 font-bold text-accent text-base">{row.br}</td>
            <td class="py-3.5 px-5 font-semibold text-ink">{row.usMen}</td>
            <td class="py-3.5 px-5 font-medium text-text-muted">{row.usWomen}</td>
            <td class="py-3.5 px-5 font-medium">{row.uk}</td>
            <td class="py-3.5 px-5 font-semibold">{row.eu}</td>
            <td class="py-3.5 px-5 font-mono">{row.cm} cm</td>
            <td class="py-3.5 px-5 font-mono text-text-muted">{row.in}″</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
