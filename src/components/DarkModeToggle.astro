---
interface Props {
  class?: string;
  size?: 'sm' | 'md';
}

const {
  class: className = '',
  size = 'md',
} = Astro.props;

const sizeClasses = size === 'sm' ? 'w-8 h-8' : 'w-9 h-9';
const iconSize = size === 'sm' ? 'w-3.5 h-3.5' : 'w-4 h-4';
---

<button
  id="theme-toggle"
  type="button"
  class={`theme-toggle-btn ${sizeClasses} rounded-full bg-canvas-soft border border-hairline-soft flex items-center justify-center text-ink hover:bg-hairline hover:border-hairline transition-all duration-200 cursor-pointer select-none shadow-2xs focus:outline-none focus-visible:ring-2 focus-visible:ring-accent ${className}`}
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <!-- Sun Icon (displayed in Dark mode) -->
  <svg
    id="theme-toggle-light-icon"
    class={`theme-icon-light hidden ${iconSize} transition-transform duration-300 transform rotate-0 hover:rotate-45`}
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    />
  </svg>

  <!-- Moon Icon (displayed in Light mode) -->
  <svg
    id="theme-toggle-dark-icon"
    class={`theme-icon-dark hidden ${iconSize} transition-transform duration-300 transform -rotate-12 hover:rotate-0`}
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    />
  </svg>
</button>

<script>
  function setupThemeToggle() {
    const toggleBtns = document.querySelectorAll('.theme-toggle-btn');
    const isDark = () => document.documentElement.classList.contains('dark') || document.documentElement.getAttribute('data-theme') === 'dark';

    function updateIcons() {
      const dark = isDark();
      document.querySelectorAll('.theme-icon-light').forEach(el => {
        el.classList.toggle('hidden', !dark);
      });
      document.querySelectorAll('.theme-icon-dark').forEach(el => {
        el.classList.toggle('hidden', dark);
      });
      document.querySelectorAll('.theme-toggle-btn').forEach(btn => {
        btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
        btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
      });
    }

    updateIcons();

    toggleBtns.forEach(btn => {
      // Remove old listeners by cloning
      btn.replaceWith(btn.cloneNode(true));
    });

    document.querySelectorAll('.theme-toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const currentlyDark = isDark();
        const nextTheme = currentlyDark ? 'light' : 'dark';

        if (nextTheme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.classList.remove('dark');
        }

        try {
          localStorage.setItem('theme', nextTheme);
        } catch {
          // ignore quota or security error
        }

        updateIcons();
      });
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
