---
import { STANDARD_RING_DATA } from '../lib/converters/ringSize';
---

<section class="mt-16 pt-12 border-t border-hairline-soft" aria-labelledby="ring-table-heading">
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-soft text-xs font-semibold text-text-muted mb-3">
      <span>ISO 8653 Jewelry Standard</span>
    </div>
    <h2 id="ring-table-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
      International Ring Size Conversion Chart.
    </h2>
    <p class="text-sm sm:text-base text-text-muted font-light mt-1 max-w-2xl">
      Official cross-reference comparison comparing US, UK, European (EU), and Japanese ring sizing standards with inside diameter and circumference measurements in millimeters and inches.
    </p>
  </div>

  <div class="overflow-x-auto rounded-3xl border border-hairline-soft bg-canvas shadow-2xs">
    <table class="w-full text-left text-sm border-collapse">
      <thead>
        <tr class="border-b border-hairline-soft bg-canvas-soft text-xs font-bold uppercase tracking-wider text-text-muted">
          <th class="py-4 px-5">US / CA</th>
          <th class="py-4 px-5">UK / AU</th>
          <th class="py-4 px-5">EU (ISO)</th>
          <th class="py-4 px-5">Japan</th>
          <th class="py-4 px-5">Diameter (mm)</th>
          <th class="py-4 px-5">Diameter (in)</th>
          <th class="py-4 px-5">Circumference (mm)</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-hairline-soft text-ink">
        {STANDARD_RING_DATA.map((row, idx) => (
          <tr class={`transition-colors hover:bg-canvas-soft/60 ${idx % 2 === 1 ? 'bg-canvas-soft/20' : 'bg-canvas'}`}>
            <td class="py-3 px-5 font-bold text-ink">{row.us}</td>
            <td class="py-3 px-5 font-semibold text-accent">{row.uk}</td>
            <td class="py-3 px-5 font-medium">{row.eu}</td>
            <td class="py-3 px-5 text-text-muted">{row.jp}</td>
            <td class="py-3 px-5 font-mono text-xs">{row.diameter_mm.toFixed(2)} mm</td>
            <td class="py-3 px-5 font-mono text-xs text-text-muted">{row.diameter_in.toFixed(3)}″</td>
            <td class="py-3 px-5 font-mono text-xs font-semibold">{row.circumference_mm.toFixed(1)} mm</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
